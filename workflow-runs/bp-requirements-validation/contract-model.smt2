; A/F/Choice/U are source-signature classifications, not solver outcomes.
; This local O005 partition does not classify O052 or the whole 56-source set.
(define-fun O005Applicable ((op Operation) (missing Bool))
  Applicability
  (ite (and (Authoring op) missing) applies non-applicable))
(define-fun O005Class ((op Operation) (missing Bool) (y Out))
  ClassDecision
  (ite (= (O005Applicable op missing) non-applicable) no-class
    (ite (or (not (o-stop y)) (not (o-needs-input y))
             (not (o-report y)) (not (o-reason-input y))
             (o-same-run-continue y)
             (not (= (o-decision-slot y) present)))
      (classified F) (classified A))))
(echo "O005 local A witness with source guard EXPECT sat")
(push)
  (assert (= (O005Class create-op true x) (classified A)))
  (check-sat) (pop)
(echo "O005 local F witness: missing answer but process continues EXPECT sat")
(push) (assert (o-same-run-continue x))
  (assert (= (O005Class update-op true x) (classified F)))
  (check-sat) (pop)
(echo "O005 guard false is non-applicable, not Choice EXPECT sat")
(push) (assert (= (O005Applicable create-op false) non-applicable))
  (assert (= (O005Class create-op false x) no-class))
  (check-sat) (pop)
(echo "O005 review subject is non-applicable, not semantic U EXPECT sat")
(push) (assert (= (O005Applicable review-op true) non-applicable))
  (assert (= (O005Class review-op true x) no-class))
  (check-sat) (pop)

; C-BP is a symbolic characteristic of the finite Ctx×Out signature, not
; a claim about host execution. F is an explicit source-duty violation list,
; never generated from simply negating A or from a solver result.
(define-fun CoreGuard ((q Ctx) (y Out)) Bool
  (or (missing-input q) (persist-fail q)
    (and (Authoring (operation q))
      (or (formal-unavailable q) (formal-false q)
        (and (nonformal-fail q)
          (or (o-complete y) (o-stop y)))))))
(define-fun CoreViolation ((q Ctx) (y Out)) Bool
  (or
    (and (missing-input q)
      (or (not (o-report y))
        (not (= (o-reason-slot y) present))
        (not (= (o-decision-slot y) present))
        (not (= (o-impact-slot y)
          (impact-availability q)))
        (not (= (o-verification-slot y)
          (verification-availability q)))
        (not (= (o-remaining-slot y)
          (remaining-availability q)))))
    (and (missing-input q) (before-goal q)
      (or (not (= (o-verification-slot y) known-absent))
          (not (= (o-remaining-slot y) known-absent))))
    (and (missing-input q) (goal-fixing q)
      (or (not (= (o-verification-slot y)
            (verification-availability q)))
          (not (= (o-remaining-slot y)
            (remaining-availability q)))))
    (and (Authoring (operation q)) (missing-approval q)
      (or (not (o-stop y)) (not (o-needs-input y))
          (o-same-run-continue y) (not (o-reason-input y))))
    (and (Authoring (operation q)) (missing-approval q)
      (not (answer-supplied q))
      (or (o-new-run y) (o-resume y)))
    (and (Authoring (operation q)) (missing-approval q)
      (o-resume y)
      (or (not (answer-supplied q)) (not (o-new-run y))))
    (and (Authoring (operation q))
      (or (formal-unavailable q) (formal-false q))
      (or (not (o-stop y)) (not (o-report y))
          (not (o-reason-formal y)) (not (o-unmet y))
          (o-complete y)
          (o-same-run-continue y)))
    (and (Authoring (operation q)) (nonformal-fail q)
      (o-stop y) (not (formal-unavailable q))
      (not (formal-false q))
      (or (not (o-report y))
          (not (o-reason-ordinary y))
          (not (o-unmet y)) (o-complete y)))
    (and (Authoring (operation q)) (nonformal-fail q)
      (o-complete y)
      (or (not (o-reverify y))
          (not (o-verification-pass y))))
    (and (persist-fail q)
      (or (not (o-stop y)) (not (o-report y))
          (o-complete y) (not (o-unsaved-scope y))
          (not (o-saved-retained y))
          (not (o-reason-save y))))))
(define-fun CoreApplicable ((q Ctx) (y Out)) Applicability
  (ite (CoreGuard q y) applies non-applicable))
(define-fun CoreReach ((q Ctx)) ReachStatus
  (ite (Realizable q) context-feasible context-infeasible))
(define-fun CoreClass ((q Ctx) (y Out)) ClassDecision
  (ite (or (= (CoreReach q) context-infeasible)
           (= (CoreApplicable q y) non-applicable)) no-class
    (ite (CoreViolation q y) (classified F)
      (classified A))))
(define-fun RewriteApplicable ((q Ctx)) Applicability
  (ite (and (Authoring (operation q))
            (nonformal-fail q)
            (not (formal-unavailable q))
            (not (formal-false q)))
    applies non-applicable))
(define-fun RewriteChoice ((q Ctx) (rewrite Bool)) ClassDecision
  (ite (or (= (CoreReach q) context-infeasible)
           (= (RewriteApplicable q) non-applicable))
    no-class (classified Choice)))
(declare-const symbolic-ctx Ctx)
(declare-const symbolic-out Out)
(declare-const compliant-out Out)
(declare-const violating-out Out)
(echo "C-BP same realizable context admits A and explicit F outputs EXPECT sat")
(push) (assert (Realizable c))
  (assert (= (CoreClass c compliant-out) (classified A)))
  (assert (= (CoreClass c violating-out) (classified F)))
  (assert (not (o-reason-save violating-out)))
  (check-sat) (pop)
(echo "C-BP A candidate cannot violate source duties in typed symbolic domain EXPECT unsat")
(push) (assert (Realizable symbolic-ctx))
  (assert (= (CoreClass symbolic-ctx symbolic-out) (classified A)))
  (assert (not (SourceDuty symbolic-ctx symbolic-out)))
  (check-sat) (pop)
(echo "C-BP F candidate cannot satisfy all source duties in typed symbolic domain EXPECT unsat")
(push) (assert (Realizable symbolic-ctx))
  (assert (= (CoreClass symbolic-ctx symbolic-out) (classified F)))
  (assert (SourceDuty symbolic-ctx symbolic-out))
  (check-sat) (pop)
(echo "C-BP false source guard is non-applicable, not Choice EXPECT sat")
(push) (assert (= symbolic-ctx
    (ctx review-op false false false false false false false false false
      known-absent known-absent known-absent)))
  (assert (= (CoreApplicable symbolic-ctx symbolic-out)
