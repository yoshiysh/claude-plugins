; C-HINT-ACK covers one full delivery/recipient snapshot and two hint bits.
; A returned output may still be rejected by CLI for a cause not specified
; by this source clause; that framed case remains semantic U.
(define-fun HintAckInputFinite ((s HState)) Bool
  (and (<= 0 (h-episode s)) (<= (h-episode s) 2)
    (= (d-run (h-delivery s)) (h-run s))
    (= (d-epoch (h-delivery s)) (h-epoch s))
    (Mask2 (h-all s)) (Mask2 (h-delivered s))
    (Mask2 (h-read s))
    (MaskSubset (h-read s) (h-all s))
    (MaskSubset (h-delivered s) (h-all s))
    (not (h-stopped s))))
(define-fun HintAckOutputFinite ((t HState)) Bool
  (and (<= 0 (h-episode t)) (<= (h-episode t) 2)
    (Mask2 (h-all t)) (Mask2 (h-delivered t))
    (Mask2 (h-read t))))
(define-fun HintAckReady ((s HState) (cmd Delivery)) Bool
  (and (h-output-returned s)
    (= (h-output-delivery s) (h-delivery s))
    (= cmd (h-delivery s))))
(define-fun HintAckOutputGood ((s HState) (t HState)) Bool
  (and (HintFrame s t)
    (= (h-delivered t) (h-delivered s))
    (= (h-output-returned t) (h-output-returned s))
    (= (h-output-delivery t) (h-output-delivery s))
    (= (h-read t)
      (MaskUnion (h-read s) (h-delivered s)))))
(define-fun HintAckScope ((s HState) (t HState)) ScopeStatus
  (ite (and (HintAckInputFinite s) (HintAckOutputFinite t))
    inside-bound outside-bound))
(define-fun HintAckClass ((s HState) (t HState)
  (cmd Delivery) (result StepResult)) ClassDecision
  (ite (= (HintAckScope s t) outside-bound) no-class
    (ite (not (HintAckReady s cmd))
      (ite (and (= result Rejected) (= t s))
        (classified A) (classified F))
      (ite (= result Accepted)
        (ite (HintAckOutputGood s t)
          (classified A) (classified F))
        (ite (and (= result Rejected) (= t s))
          (classified U) (classified F))))))
(declare-const ack-input HState)
(declare-const ack-good HState)
(declare-const ack-bad HState)
(declare-const ack-command Delivery)
(echo "C-HINT same returned delivery admits A union and F old-read-loss outputs EXPECT sat")
