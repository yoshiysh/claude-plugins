; C-VERIFY is a finite BP authoring transition projection. Event selection
; is input: ordinary rewrite remains optional; formal failure stop is due.
(declare-datatypes ((VerifyEvent 0)) (((complete-event)
  (formal-stop-event) (rewrite-reverify-event))))
(define-fun VerifyInputFinite ((s VState)) Bool
  (and (= (v-run s) old-run) (= (v-target s) 81)
    (<= 0 (v-generation s)) (<= (v-generation s) 1)
    (<= 0 (v-generator-ctx s)) (<= (v-generator-ctx s) 1)
    (<= 0 (v-checker-ctx s)) (<= (v-checker-ctx s) 1)))
(define-fun VerifyOutputFinite ((t VState)) Bool
  (and (= (v-target t) 81)
    (<= 0 (v-generation t)) (<= (v-generation t) 2)
    (<= 0 (v-generator-ctx t)) (<= (v-generator-ctx t) 1)
    (<= 0 (v-checker-ctx t)) (<= (v-checker-ctx t) 1)
    (<= 0 (v-report-target t)) (<= (v-report-target t) 81)))
(define-fun VerifyScope ((s VState) (t VState)) ScopeStatus
  (ite (and (VerifyInputFinite s) (VerifyOutputFinite t))
    inside-bound outside-bound))
(define-fun VerifyApplicable ((s VState) (ev VerifyEvent))
  Applicability
  (ite (or (and (= ev complete-event)
                 (= (v-result s) passing-verification))
           (and (= ev formal-stop-event)
                 (or (= (v-result s) formal-unavailable-result)
                     (= (v-result s) formal-false-result)))
           (and (= ev rewrite-reverify-event)
                 (= (v-result s) ordinary-failure)))
    applies non-applicable))
(define-fun VerifyViolation ((s VState) (t VState)
  (ev VerifyEvent)) Bool
  (or (not (= (v-run t) (v-run s)))
    (not (= (v-target t) (v-target s)))
    (not (= (v-generator-ctx t) (v-generator-ctx s)))
    (not (= (v-report-target t)
      (ite (= ev formal-stop-event) (v-target s)
        (v-report-target s))))
    (and (= ev complete-event)
      (or (= (v-generator-ctx s) (v-checker-ctx s))
          (not (= (v-generation t) (v-generation s)))
          (not (= (v-checker-ctx t) (v-checker-ctx s)))
          (not (= (v-result t) (v-result s)))
          (v-stopped t) (v-reported t)
          (not (= (v-report-reason t) (v-report-reason s)))
          (not (v-complete t))))
    (and (= ev formal-stop-event)
      (or (not (= (v-generation t) (v-generation s)))
          (not (= (v-checker-ctx t) (v-checker-ctx s)))
          (not (= (v-result t) (v-result s)))
          (not (v-stopped t)) (not (v-reported t))
          (not (v-report-reason t)) (v-complete t)))
    (and (= ev rewrite-reverify-event)
      (or (not (= (v-generation t)
            (+ (v-generation s) 1)))
          (= (v-checker-ctx t) (v-generator-ctx s))
          (not (= (v-result t) pending-verification))
          (v-stopped t) (v-reported t)
          (not (= (v-report-reason t) (v-report-reason s)))
          (v-complete t)))))
(define-fun VerifyClass ((s VState) (t VState)
  (ev VerifyEvent)) ClassDecision
  (ite (or (= (VerifyScope s t) outside-bound)
           (= (VerifyApplicable s ev) non-applicable))
    no-class
    (ite (VerifyViolation s t ev)
      (classified F) (classified A))))
