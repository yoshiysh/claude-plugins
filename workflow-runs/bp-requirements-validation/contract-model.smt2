; C-FINDING covers the selected oldrun finding/groundRef→newrun finding pair.
; It classifies logical report identity, not the meaning of the ground text.
(define-fun FindingInputFinite ((s FState)) Bool
  (and (= (fs-run s) current-run) (= (fs-epoch s) e1)
    (= (fs-old-id s) 41) (= (fs-current-id s) 42)
    (= (g-origin-run (fs-origin s)) old-run)
    (= (g-origin-finding (fs-origin s)) 41)
    (= (g-id (fs-origin s)) 71)
    (= (g-origin-run (fs-current-ground s)) old-run)
    (= (g-origin-finding (fs-current-ground s)) 41)
    (= (g-id (fs-current-ground s)) 72)
    (not (fs-received s)) (not (fs-evaluated s))
    (= (fs-current-status s) no-current-status)
    (not (fs-report-old-status s)) (not (fs-reported s))))
(define-fun FindingOutputFinite ((t FState)) Bool
  (and (= (fs-run t) current-run) (= (fs-epoch t) e1)
    (<= 41 (fs-old-id t)) (<= (fs-old-id t) 42)
    (<= 41 (fs-current-id t)) (<= (fs-current-id t) 42)
    (<= 71 (g-id (fs-origin t)))
    (<= (g-id (fs-origin t)) 72)
    (<= 71 (g-id (fs-current-ground t)))
    (<= (g-id (fs-current-ground t)) 72)))
(define-fun FindingFinalViolation ((s FState) (t FState)) Bool
  (or (not (= (fs-old-id t) (fs-old-id s)))
    (= (fs-current-id t) (fs-old-id t))
    (not (= (fs-current-id t) (fs-current-id s)))
    (not (= (fs-origin t) (fs-origin s)))
    (not (= (fs-current-ground t) (fs-current-ground s)))
    (not (= (g-origin-run (fs-current-ground t)) old-run))
    (not (= (g-origin-finding (fs-current-ground t))
      (fs-old-id t)))
    (not (fs-received t)) (not (fs-evaluated t))
    (= (fs-current-status t) no-current-status)
    (fs-report-old-status t) (not (fs-reported t))))
(define-fun FindingScope ((s FState) (t FState)) ScopeStatus
  (ite (and (FindingInputFinite s) (FindingOutputFinite t))
    inside-bound outside-bound))
(define-fun FindingClass ((s FState) (t FState)) ClassDecision
  (ite (= (FindingScope s t) outside-bound) no-class
