; S12–S14/S31: operation-level interruption is independent of target-run
; fan-out. A stopped chain cannot start its downstream operation.
(declare-datatypes ((IState 0)) (((is (i-op Operation) (i-run Run)
  (i-episode Int)
  (i-phase Phase) (i-written-mask Int) (i-verified-mask Int)
  (i-unverified-mask Int) (i-stop Bool) (i-blocked Bool)
  (i-reason Int) (i-reason-reported Bool)
  (i-phase-reported Bool) (i-chain-report Bool)
  (i-downstream-started Bool)))))
(define-fun Interrupt ((s IState) (t IState)
  (unrecoverable Bool)) Bool
  (and (= (i-op t) (i-op s)) (= (i-run t) (i-run s))
    (= (i-episode t) (+ (i-episode s) 1))
    (= (i-phase t) (i-phase s))
    (= (i-written-mask t) (i-written-mask s))
    (= (i-verified-mask t) (i-verified-mask s))
    (= (i-unverified-mask t) (i-unverified-mask s))
    (i-stop t) (= (i-blocked t) unrecoverable)
    (= (i-reason t) 7) (not (i-reason-reported t))
    (not (i-phase-reported t)) (not (i-chain-report t))
    (not (i-downstream-started t))))
(define-fun InterruptReport ((s IState) (t IState)) Bool
  (and (i-stop s) (= (i-op t) (i-op s))
    (= (i-run t) (i-run s))
    (= (i-episode t) (i-episode s))
    (= (i-phase t) (i-phase s))
    (= (i-written-mask t) (i-written-mask s))
    (= (i-verified-mask t) (i-verified-mask s))
    (= (i-unverified-mask t) (i-unverified-mask s))
    (= (i-stop t) (i-stop s))
    (= (i-blocked t) (i-blocked s))
    (= (i-reason t) (i-reason s))
    (i-reason-reported t) (i-phase-reported t)
    (i-chain-report t) (not (i-downstream-started t))))
(declare-const i0 IState) (declare-const i1 IState)
(declare-const i2 IState)
(echo "S12/S31 Reach partial files→interrupt→chain report, written mask retained EXPECT sat")
(push) (assert (= i0 (is create-op old-run 0 execute-phase 3 1 2
    false false 0 false false false false)))
  (assert (Interrupt i0 i1 false))
  (assert (InterruptReport i1 i2)) (check-sat)
  (get-value ((i-written-mask i2) (i-verified-mask i2)
    (i-unverified-mask i2) (i-phase-reported i2)
    (i-reason-reported i2) (i-chain-report i2)
    (i-downstream-started i2))) (pop)
(echo "S12 forbidden rollback of written files after interruption EXPECT unsat")
(push) (assert (= i0 (is create-op old-run 0 execute-phase 3 1 2
    false false 0 false false false false)))
  (assert (Interrupt i0 i1 false))
  (assert (InterruptReport i1 i2))
  (assert (= (i-written-mask i2) 0)) (check-sat) (pop)
(echo "S13 review nonfailure interruption still reports phase/reason EXPECT sat")
(push) (assert (= i0 (is review-op old-run 0 execute-phase 0 0 0
    false false 0 false false false false)))
  (assert (Interrupt i0 i1 false))
  (assert (InterruptReport i1 i2)) (check-sat) (pop)
(echo "S13 forbidden review interruption omits stopped phase EXPECT unsat")
(push) (assert (= i0 (is review-op old-run 0 execute-phase 0 0 0
    false false 0 false false false false)))
  (assert (Interrupt i0 i1 false))
  (assert (InterruptReport i1 i2))
  (assert (not (i-phase-reported i2)))
  (check-sat) (pop)
(echo "S14 unrecoverable interruption is BLOCKED EXPECT sat")
(push) (assert (= i0 (is audit-op old-run 0 execute-phase 0 0 0
