; S24/S25: the external repair's effect on input contents chooses the
; source-defined boundary. Changed input starts a new state; unchanged input
; can resume a noncompleted stop, preserving history and item position.
(declare-datatypes ((RepairEvent 0)) (((repair-event
  (repair-run Run) (repair-cause Int)
  (repair-old-content Int) (repair-new-content Int)
  (repair-success Bool)))))
(define-fun RepairMatchesBlocked ((s Record) (e RepairEvent)) Bool
  (and (rec-blocked s) (not (= (rec-cause s) 0))
    (= (repair-run e) (rec-run s))
    (= (repair-cause e) (rec-cause s))
    (= (repair-old-content e) (rec-input-content s))
    (repair-success e)))
(define-fun NewStateAfterInputChange ((s Record) (t Record)
  (e RepairEvent)) Bool
  (and (RepairMatchesBlocked s e)
    (not (= (repair-new-content e) (repair-old-content e)))
    (= (rec-run s) old-run) (= (rec-run t) current-run)
    (= (rec-epoch s) e0) (= (rec-epoch t) e1)
    (= (rec-episode t) (+ (rec-episode s) 1))
    (= (rec-phase t) input-phase) (= (rec-round t) 0)
    (= (rec-item t) 0) (= (rec-remaining t) 3)
    (= (rec-rank-i0 t) 0) (= (rec-rank-i1 t) 1)
    (= (rec-reason t) 0) (= (rec-saved t) (rec-saved s))
    (= (rec-history t) (rec-history s))
    (= (rec-plan t) 0) (= (rec-read t) 0)
    (= (rec-delivery t)
      (delivery current-run e1 0 0 input-phase 0 0))
    (= (rec-output-delivery t) (rec-delivery t))
    (not (rec-output-returned t))
    (= (rec-stop-phase t) input-phase)
    (= (rec-unrecorded t) 3) (= (rec-recorded t) 0)
    (not (rec-blocked t)) (= (rec-cause t) 0)
    (= (rec-input-content t) (repair-new-content e))
    (= (rec-stop-snapshot t) 0)))
(define-fun SameStateAfterRepair ((s Record) (t Record)
  (e RepairEvent)) Bool
  (and (RepairMatchesBlocked s e)
    (= (repair-new-content e) (repair-old-content e))
    (= (rec-run s) old-run) (= (rec-run t) current-run)
    (= (rec-epoch s) e0) (= (rec-epoch t) e1)
    (= (rec-episode t) (rec-episode s))
    (= (rec-phase t) (rec-phase s))
    (= (rec-round t) (rec-round s))
    (= (rec-item t) (rec-item s))
    (= (rec-remaining t) (rec-remaining s))
    (= (rec-rank-i0 t) (rec-rank-i0 s))
    (= (rec-rank-i1 t) (rec-rank-i1 s))
    (= (rec-reason t) (rec-reason s))
    (= (rec-saved t) (rec-saved s))
    (= (rec-history t) (rec-history s))
    (= (rec-plan t) (rec-plan s))
    (= (rec-read t) (rec-read s))
    (= (rec-delivery t)
      (delivery current-run e1 0 0 (rec-phase s) (rec-round s) 0))
    (= (rec-output-delivery t) (rec-delivery t))
    (not (rec-output-returned t))
    (= (rec-stop-phase t) (rec-stop-phase s))
    (= (rec-unrecorded t) (rec-unrecorded s))
    (= (rec-recorded t) (rec-recorded s))
    (not (rec-blocked t)) (= (rec-cause t) (rec-cause s))
    (= (rec-input-content t) (repair-new-content e))
    (= (rec-stop-snapshot t) (rec-stop-snapshot s))))
(declare-const old-rec Record) (declare-const new-rec Record)
(assert (= old-rec (record old-run e0 1 execute-phase 4
  1 2 0 1 7 1 5 9
  (delivery old-run e0 1 2 execute-phase 4 1)
  0 false (delivery old-run e0 1 2 execute-phase 4 1)
  execute-phase 2 1 true 7 100 17)))
(declare-const repair-changed RepairEvent)
(declare-const repair-same RepairEvent)
(assert (= repair-changed (repair-event old-run 7 100 101 true)))
(assert (= repair-same (repair-event old-run 7 100 100 true)))
(echo "S24 changed input→new state retains history, resets current item/plan EXPECT sat")
(push) (assert (NewStateAfterInputChange old-rec new-rec repair-changed))
  (check-sat) (get-value ((rec-run new-rec) (rec-episode new-rec)
    (rec-phase new-rec) (rec-item new-rec) (rec-remaining new-rec)
    (rec-history new-rec) (rec-input-content new-rec)
    (rec-stop-snapshot new-rec))) (pop)
(echo "S24 forbidden same-state resume after changed input EXPECT unsat")
(push) (assert (SameStateAfterRepair old-rec new-rec repair-changed))
  (check-sat) (pop)
(echo "S25 repaired unchanged input→same-state new-run position EXPECT sat")
(push) (assert (SameStateAfterRepair old-rec new-rec repair-same))
  (check-sat) (get-value ((rec-run new-rec) (rec-episode new-rec)
    (rec-phase new-rec) (rec-item new-rec) (rec-history new-rec)
    (rec-cause new-rec) (rec-stop-snapshot new-rec))) (pop)
(echo "S24/S25 wrong blocked cause cannot authorize restart EXPECT unsat")
(push) (assert (SameStateAfterRepair old-rec new-rec
    (repair-event old-run 8 100 100 true)))
  (check-sat) (pop)
(echo "S24/S25 unacknowledged repair cannot authorize restart EXPECT unsat")
(push) (assert (NewStateAfterInputChange old-rec new-rec
    (repair-event old-run 7 100 101 false)))
  (check-sat) (pop)

; S26: two finite no-input samples. Parallelism is a separate value from
