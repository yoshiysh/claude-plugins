; C-ENTRY is a finite StageRef projection for the target Workflow. The
; four phases and two rank orders are representatives, not host stage names.
(define-fun TargetStagePhase ((p Phase)) Bool
  (or (= p plan-phase) (= p execute-phase)
      (= p check-phase) (= p decide-phase)))
(define-fun EntryInputFinite ((s RState)) Bool
  (and (<= 0 (rs-episode s)) (<= (rs-episode s) 2)
    (TargetStagePhase (rs-stop-phase s))
    (Mask2 (rs-unrecorded s)) (Mask2 (rs-recorded s))
    (Mask2 (rs-remaining s))
    (<= 0 (rs-rank-i0 s)) (<= (rs-rank-i0 s) 1)
    (<= 0 (rs-rank-i1 s)) (<= (rs-rank-i1 s) 1)
    (Mask2 (rs-unread-hints s))
    (Mask2 (rs-read-hints s))))
(define-fun EntryReach ((s RState)) ReachStatus
  (ite (and (= (rs-run s) old-run) (= (rs-epoch s) e0)
    (MaskDisjoint (rs-unrecorded s) (rs-recorded s))
    (= (MaskUnion (rs-unrecorded s) (rs-recorded s)) 3)
    (= (rs-remaining s) (rs-unrecorded s))
    (not (= (rs-rank-i0 s) (rs-rank-i1 s)))
    (MaskDisjoint (rs-unread-hints s) (rs-read-hints s)))
    context-feasible context-infeasible))
(define-fun EntryApplicable ((s RState)) Applicability
  (ite (or (rs-complete s) (rs-input-changed s))
    non-applicable applies))
(define-fun EntryInputFeasible ((s RState)) Bool
  (and (EntryInputFinite s)
    (= (EntryReach s) context-feasible)
    (= (EntryApplicable s) applies)))
(define-fun EntryOutputFinite ((t RState)) Bool
  (and (<= 0 (rs-episode t)) (<= (rs-episode t) 2)
    (TargetStagePhase (rs-stop-phase t))
    (Mask2 (rs-unrecorded t)) (Mask2 (rs-recorded t))
    (Mask2 (rs-remaining t))
    (<= 0 (rs-rank-i0 t)) (<= (rs-rank-i0 t) 1)
    (<= 0 (rs-rank-i1 t)) (<= (rs-rank-i1 t) 1)
    (Mask2 (rs-unread-hints t)) (Mask2 (rs-read-hints t))))
(define-fun EntryViolation ((s RState) (t RState)) Bool
  (or (not (= (rs-run t) current-run))
    (not (= (rs-epoch t) e1))
    (not (= (rs-episode t) (rs-episode s)))
    (not (= (rs-stop-phase t) (rs-stop-phase s)))
    (not (= (rs-unrecorded t) (rs-unrecorded s)))
    (not (= (rs-recorded t) (rs-recorded s)))
    (not (= (rs-remaining t) (rs-remaining s)))
    (not (= (rs-rank-i0 t) (rs-rank-i0 s)))
    (not (= (rs-rank-i1 t) (rs-rank-i1 s)))
    (not (= (rs-unread-hints t) (rs-unread-hints s)))
    (not (= (rs-read-hints t) (rs-read-hints s)))
    (not (= (rs-has-planner t) (rs-has-planner s)))
    (rs-complete t) (rs-input-changed t)
    (not (= (rs-entry t)
      (SourceExpectedEntry (rs-has-planner s)
        (> (rs-unread-hints s) 0)
        (> (rs-unrecorded s) 0))))))
(define-fun EntryScope ((s RState) (t RState)) ScopeStatus
  (ite (and (EntryInputFinite s)
            (EntryOutputFinite t))
    inside-bound outside-bound))
(define-fun EntryClass ((s RState) (t RState)) ClassDecision
  (ite (or (= (EntryScope s t) outside-bound)
           (= (EntryReach s) context-infeasible)
           (= (EntryApplicable s) non-applicable)) no-class
    (ite (EntryViolation s t)
      (classified F) (classified A))))
