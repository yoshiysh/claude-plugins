(declare-datatypes ((Host 0)) (((codex-runner) (native-workflow))))
(declare-datatypes ((HostCase 0)) (((hostcase (host-name Host)
  (fanout-items Int) (input-cap Int) (total-starts Int)
  (concurrency Int)))))
(define-fun HostCapDuty ((h HostCase)) Bool
  (and (<= 1 (fanout-items h))
    (<= 1 (concurrency h))
    (<= (concurrency h) (fanout-items h))
    (ite (= (host-name h) codex-runner)
      (<= 0 (input-cap h))
      (= (input-cap h) (- 1)))))
