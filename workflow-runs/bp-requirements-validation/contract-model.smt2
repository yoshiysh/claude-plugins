  (assert (not (HintCliAccept ack-input ack-good ack-command)))
  (check-sat) (pop)
(echo "C-HINT F accepted output cannot satisfy union receipt relation EXPECT unsat")
(push) (assert (HintAckInputFinite ack-input))
  (assert (HintAckReady ack-input ack-command))
