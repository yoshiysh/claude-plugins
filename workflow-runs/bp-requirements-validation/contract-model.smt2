; C-CAP covers two ranked target items and one/two run-local starts.
(declare-datatypes ((CapEvent 0)) (((attempt-noresponse-event)
  (cap-stop-event) (cap-newrun-event))))
(define-fun CapInputFinite ((s CapState)) Bool
  (and (<= 0 (cap-count s)) (<= (cap-count s) 2)
    (<= 1 (cap-limit s)) (<= (cap-limit s) 2)
    (<= 0 (cap-episode s)) (<= (cap-episode s) 2)
    (<= 0 (cap-rank-i0 s)) (<= (cap-rank-i0 s) 1)
    (<= 0 (cap-rank-i1 s)) (<= (cap-rank-i1 s) 1)))
(define-fun CapOutputFinite ((t CapState)) Bool
  (and (<= 0 (cap-count t)) (<= (cap-count t) 2)
    (<= 1 (cap-limit t)) (<= (cap-limit t) 2)
    (<= 0 (cap-episode t)) (<= (cap-episode t) 2)
    (<= 0 (cap-rank-i0 t)) (<= (cap-rank-i0 t) 1)
    (<= 0 (cap-rank-i1 t)) (<= (cap-rank-i1 t) 1)))
(define-fun CapScope ((s CapState) (t CapState)) ScopeStatus
  (ite (and (CapInputFinite s) (CapOutputFinite t))
    inside-bound outside-bound))
(define-fun CapReach ((s CapState)) ReachStatus
  (ite (and (= (cap-run s) old-run) (= (cap-epoch s) e0)
    (not (= (cap-rank-i0 s) (cap-rank-i1 s)))
    (<= (cap-count s) (cap-limit s))
    (=> (cap-i0-unstarted s) (not (cap-i0-result s)))
    (=> (cap-i1-unstarted s) (not (cap-i1-result s))))
    context-feasible context-infeasible))
(define-fun CapApplicable ((s CapState) (ev CapEvent))
  Applicability
  (ite (or
    (and (= ev attempt-noresponse-event)
      (not (cap-stopped s)) (cap-i0-unstarted s)
      (< (cap-count s) (cap-limit s)))
    (and (= ev cap-stop-event)
      (not (cap-stopped s)) (cap-i1-unstarted s)
      (= (cap-count s) (cap-limit s)))
    (and (= ev cap-newrun-event) (cap-stopped s)))
    applies non-applicable))
(define-fun CapViolation ((s CapState) (t CapState)
  (ev CapEvent)) Bool
  (or (not (= (cap-limit t) (cap-limit s)))
    (not (= (cap-rank-i0 t) (cap-rank-i0 s)))
    (not (= (cap-rank-i1 t) (cap-rank-i1 s)))
    (and (= ev attempt-noresponse-event)
      (or (not (= (cap-run t) (cap-run s)))
        (not (= (cap-epoch t) (cap-epoch s)))
        (not (= (cap-episode t) (cap-episode s)))
        (not (= (cap-count t) (+ (cap-count s) 1)))
        (> (cap-count t) (cap-limit s))
        (cap-i0-unstarted t)
        (not (= (cap-i1-unstarted t) (cap-i1-unstarted s)))
        (cap-i0-result t)
        (not (= (cap-i1-result t) (cap-i1-result s)))
        (cap-stopped t)))
    (and (= ev cap-stop-event)
      (or (not (= (cap-run t) (cap-run s)))
        (not (= (cap-epoch t) (cap-epoch s)))
        (not (= (cap-episode t) (+ (cap-episode s) 1)))
        (not (= (cap-count t) (cap-count s)))
        (not (= (cap-i0-unstarted t) (cap-i0-unstarted s)))
        (not (= (cap-i1-unstarted t) (cap-i1-unstarted s)))
        (not (= (cap-i0-result t) (cap-i0-result s)))
        (not (= (cap-i1-result t) (cap-i1-result s)))
        (not (cap-stopped t))))
    (and (= ev cap-newrun-event)
      (or (not (= (cap-run t) current-run))
        (not (= (cap-epoch t) e1))
        (not (= (cap-episode t) (cap-episode s)))
        (not (= (cap-count t) 0))
        (not (= (cap-i0-unstarted t) (cap-i0-unstarted s)))
        (not (= (cap-i1-unstarted t) (cap-i1-unstarted s)))
        (not (= (cap-i0-result t) (cap-i0-result s)))
        (not (= (cap-i1-result t) (cap-i1-result s)))
        (cap-stopped t)))))
(define-fun CapClass ((s CapState) (t CapState)
  (ev CapEvent)) ClassDecision
  (ite (or (= (CapScope s t) outside-bound)
           (= (CapReach s) context-infeasible)
           (= (CapApplicable s ev) non-applicable))
    no-class
    (ite (CapViolation s t ev)
      (classified F) (classified A))))
(declare-const cap-good CapState) (declare-const cap-bad CapState)
(echo "C-CAP no-response attempt same initial context admits A and no-count F EXPECT sat")
(push) (assert (= (CapClass a0 cap-good attempt-noresponse-event)
    (classified A)))
  (assert (= (CapClass a0 cap-bad attempt-noresponse-event)
    (classified F)))
  (assert (= (cap-count cap-bad) 0))
  (check-sat) (pop)
(echo "C-CAP A no-response attempt must count a start EXPECT unsat")
(push) (assert (= (CapClass a0 cap-good attempt-noresponse-event)
    (classified A)))
  (assert (not (SourceAttemptDuty a0 cap-good)))
  (check-sat) (pop)
(echo "C-CAP stopped snapshot A newrun resets count/retains rank EXPECT sat")
(push) (assert (= (CapClass s29-snapshot cap-good cap-newrun-event)
    (classified A)))
  (assert (CapNewRun s29-snapshot cap-good))
  (check-sat) (pop)
(echo "C-CAP wrong run count after cap stop is F EXPECT sat")
(push) (assert (= (CapClass s29-snapshot cap-bad cap-newrun-event)
    (classified F)))
  (assert (= (cap-count cap-bad) 1))
  (check-sat) (pop)
