; C-HANDOFF is the 2-item/limit-1..2 source-stop projection. A missing
; handoff-stop guard is non-applicable for this rule; other duties may apply.
(define-fun HandoffInputFinite ((s Handoff)) Bool
  (and (= (ho-run s) old-run) (= (ho-epoch s) e0)
    (<= 0 (ho-episode s)) (<= (ho-episode s) 2)
    (<= 0 (ho-count s)) (<= (ho-count s) 2)
    (<= 1 (ho-limit s)) (<= (ho-limit s) 2)
    (<= (ho-count s) (ho-limit s))
    (Mask2 (ho-remaining s))
    (Mask2 (ho-truncate-permission s))))
(define-fun HandoffOutputFinite ((t Handoff)) Bool
  (and (<= 0 (ho-episode t)) (<= (ho-episode t) 2)
    (<= 0 (ho-count t)) (<= (ho-count t) 2)
    (<= 1 (ho-limit t)) (<= (ho-limit t) 3)
    (Mask2 (ho-remaining t))
    (Mask2 (ho-truncate-permission t))))
(define-fun HandoffViolation ((s Handoff) (t Handoff)) Bool
  (or (not (= (ho-run t) current-run))
    (not (= (ho-epoch t) e1))
    (not (= (ho-episode t) (ho-episode s)))
    (not (= (ho-count t) (ho-count s)))
    (not (= (ho-remaining t) (ho-remaining s)))
    (ho-stopped-by-handoff t)
    (not (MaskSubset (ho-truncate-permission t)
      (ho-remaining s)))
    (and (<= (ho-limit t) (ho-limit s))
         (= (ho-truncate-permission t) 0))))
(define-fun HandoffApplicable ((s Handoff)) Applicability
  (ite (and (ho-stopped-by-handoff s)
            (= (ho-count s) (ho-limit s)))
    applies non-applicable))
(define-fun HandoffScope ((s Handoff) (t Handoff)) ScopeStatus
  (ite (and (HandoffInputFinite s) (HandoffOutputFinite t))
    inside-bound outside-bound))
(define-fun HandoffClass ((s Handoff) (t Handoff)) ClassDecision
  (ite (or (= (HandoffScope s t) outside-bound)
           (= (HandoffApplicable s) non-applicable)) no-class
    (ite (HandoffViolation s t)
      (classified F) (classified A))))
