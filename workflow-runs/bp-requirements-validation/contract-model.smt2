; S01–S04/S27: BP create/update verification cutpoints. A formal failure
; stops the current run; an ordinary failure may be rewritten and independently
; checked in this run. Completion requires a distinct passing context.
(declare-datatypes ((Verification 0)) (((pending-verification)
  (ordinary-failure) (formal-unavailable-result)
  (formal-false-result) (passing-verification))))
(declare-datatypes ((VState 0)) (((vs (v-run Run) (v-target Int)
  (v-generation Int) (v-generator-ctx Int) (v-checker-ctx Int)
  (v-result Verification) (v-stopped Bool) (v-reported Bool)
  (v-report-target Int) (v-report-reason Bool)
  (v-complete Bool)))))
(define-fun OrdinaryFailure ((s VState) (t VState)) Bool
  (and (= (v-run t) (v-run s)) (= (v-target t) (v-target s))
    (= (v-generation t) (v-generation s))
    (= (v-generator-ctx t) (v-generator-ctx s))
    (= (v-checker-ctx t) (v-checker-ctx s))
    (= (v-result t) ordinary-failure)
    (not (v-stopped t)) (not (v-reported t))
    (= (v-report-target t) (v-report-target s))
    (= (v-report-reason t) (v-report-reason s))
    (not (v-complete t))))
(define-fun RewriteAndReverify ((s VState) (t VState)) Bool
  (and (= (v-result s) ordinary-failure)
    (= (v-run t) (v-run s)) (= (v-target t) (v-target s))
    (= (v-generation t) (+ (v-generation s) 1))
    (= (v-generator-ctx t) (v-generator-ctx s))
    (not (= (v-checker-ctx t) (v-generator-ctx s)))
    (= (v-result t) pending-verification)
    (not (v-stopped t)) (not (v-reported t))
    (= (v-report-target t) (v-report-target s))
    (= (v-report-reason t) (v-report-reason s))
    (not (v-complete t))))
(define-fun VerificationPass ((s VState) (t VState)) Bool
  (and (= (v-result s) pending-verification)
    (not (= (v-checker-ctx s) (v-generator-ctx s)))
    (= (v-run t) (v-run s)) (= (v-target t) (v-target s))
    (= (v-generation t) (v-generation s))
    (= (v-generator-ctx t) (v-generator-ctx s))
    (= (v-checker-ctx t) (v-checker-ctx s))
    (= (v-result t) passing-verification)
    (not (v-stopped t)) (not (v-reported t))
    (= (v-report-target t) (v-report-target s))
    (= (v-report-reason t) (v-report-reason s))
    (not (v-complete t))))
(define-fun CompleteAfterPass ((s VState) (t VState)) Bool
  (and (= (v-result s) passing-verification)
    (not (= (v-checker-ctx s) (v-generator-ctx s)))
    (= (v-run t) (v-run s)) (= (v-target t) (v-target s))
    (= (v-generation t) (v-generation s))
    (= (v-generator-ctx t) (v-generator-ctx s))
    (= (v-checker-ctx t) (v-checker-ctx s))
    (= (v-result t) (v-result s))
    (not (v-stopped t)) (not (v-reported t))
    (= (v-report-target t) (v-report-target s))
    (= (v-report-reason t) (v-report-reason s))
    (v-complete t)))
(define-fun FormalStop ((s VState) (t VState)) Bool
  (and (or (= (v-result s) formal-unavailable-result)
           (= (v-result s) formal-false-result))
    (= (v-run t) (v-run s)) (= (v-target t) (v-target s))
    (= (v-generation t) (v-generation s))
    (= (v-generator-ctx t) (v-generator-ctx s))
    (= (v-checker-ctx t) (v-checker-ctx s))
    (= (v-result t) (v-result s))
    (v-stopped t) (v-reported t)
    (= (v-report-target t) (v-target s))
    (v-report-reason t) (not (v-complete t))))
(define-fun FormalObservation ((s VState) (t VState)) Bool
  (and (= (v-result s) pending-verification)
    (or (= (v-result t) formal-unavailable-result)
        (= (v-result t) formal-false-result))
    (= (v-run t) (v-run s)) (= (v-target t) (v-target s))
    (= (v-generation t) (v-generation s))
    (= (v-generator-ctx t) (v-generator-ctx s))
    (= (v-checker-ctx t) (v-checker-ctx s))
    (not (v-stopped t)) (not (v-reported t))
    (= (v-report-target t) (v-report-target s))
    (= (v-report-reason t) (v-report-reason s))
    (not (v-complete t))))
(declare-const v0 VState) (declare-const v1 VState)
(declare-const v2 VState) (declare-const v3 VState)
