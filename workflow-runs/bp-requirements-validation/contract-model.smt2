(set-logic ALL)
(set-option :print-success false)
(set-option :timeout 10000)

; Finite source-cutpoint contract. Classification, transition result, and
; solver status have different types. The solver does not decide Class.
(declare-datatypes ((Run 0)) (((old-run) (current-run))))
(declare-datatypes ((Epoch 0)) (((e0) (e1))))
(declare-datatypes ((StepResult 0)) (((Accepted) (Rejected) (Stopped) (Reported) (Completed))))
(declare-datatypes ((Class 0)) (((A) (F) (Choice) (U))))
(declare-datatypes ((ClassDecision 0)) (((classified
  (class-value Class)) (no-class))))
(declare-datatypes ((ScopeStatus 0)) (((inside-bound)
  (outside-bound))))
(declare-datatypes ((ReachStatus 0)) (((context-feasible)
  (context-infeasible) (reach-unchecked))))
(declare-datatypes ((Applicability 0)) (((applies)
  (non-applicable) (applicability-unknown))))
(declare-datatypes ((SolverStatus 0)) (((sat-status) (unsat-status) (unknown-status) (timeout-status) (error-status) (not-run-status))))
(declare-datatypes ((Slot 0)) (((present) (known-absent)
  (availability-unknown))))
(declare-datatypes ((SaveState 0)) (((saved) (unsaved)
  (save-unknown))))
(declare-datatypes ((FindingStatus 0)) (((no-current-status) (open-status) (dismissed-status) (resolved-status) (regressed-status))))
(declare-datatypes ((Operation 0)) (((create-op) (update-op)
  (review-op) (audit-op))))
(define-fun Authoring ((op Operation)) Bool
  (or (= op create-op) (= op update-op)))

; A context is source input. An output is an observed decision/report. Source
; duties constrain output only after the same context has been realized.
(declare-datatypes ((Ctx 0)) (((ctx (operation Operation)
  (missing-input Bool) (missing-approval Bool) (before-goal Bool)
  (goal-fixing Bool) (formal-unavailable Bool) (formal-false Bool)
  (nonformal-fail Bool) (persist-fail Bool) (answer-supplied Bool)
  (impact-availability Slot) (verification-availability Slot)
  (remaining-availability Slot)))))
(declare-datatypes ((Out 0)) (((out (o-stop Bool) (o-report Bool)
  (o-complete Bool) (o-needs-input Bool) (o-same-run-continue Bool)
  (o-new-run Bool) (o-resume Bool) (o-rewrite Bool) (o-reverify Bool)
  (o-verification-pass Bool) (o-reason-input Bool) (o-reason-formal Bool)
  (o-reason-save Bool) (o-reason-ordinary Bool) (o-unmet Bool)
  (o-unsaved-scope Bool) (o-saved-retained Bool)
  (o-reason-slot Slot) (o-decision-slot Slot) (o-verification-slot Slot)
  (o-impact-slot Slot) (o-remaining-slot Slot)
  (o-report-persistence SaveState)))))

(define-fun Realizable ((c Ctx)) Bool
  (and (not (and (before-goal c) (goal-fixing c)))
       (=> (missing-approval c) (missing-input c))
       (=> (answer-supplied c) (missing-approval c))
       (=> (before-goal c)
         (and (= (verification-availability c) known-absent)
              (= (remaining-availability c) known-absent)))
       (=> (or (before-goal c) (goal-fixing c))
         (Authoring (operation c)))))
(define-fun CoreDuty ((c Ctx) (x Out)) Bool
  (and
    ; O005/O052: answer may be supplied later, but no-answer stop/report is due.
    (=> (missing-input c)
      (and (o-report x)
           (= (o-reason-slot x) present)
           (= (o-impact-slot x) (impact-availability c))
           (= (o-verification-slot x)
             (verification-availability c))
           (= (o-remaining-slot x)
             (remaining-availability c))))
    (=> (and (Authoring (operation c)) (missing-approval c))
      (and (o-stop x) (o-needs-input x)
           (not (o-same-run-continue x)) (o-reason-input x)))
    (=> (and (missing-input c) (before-goal c))
      (and (= (o-verification-slot x) known-absent)
           (= (o-remaining-slot x) known-absent)))
    (=> (and (missing-input c) (goal-fixing c))
      (and (= (o-verification-slot x)
             (verification-availability c))
           (= (o-remaining-slot x)
             (remaining-availability c))))
    (=> (and (Authoring (operation c))
             (missing-approval c) (not (answer-supplied c)))
      (and (not (o-new-run x)) (not (o-resume x))))
    (=> (and (Authoring (operation c))
             (missing-approval c) (o-resume x))
      (and (answer-supplied c) (o-new-run x)))
    ; D027/O011: formal failure stops this run. Nonformal rewrite is optional.
    (=> (and (Authoring (operation c))
             (or (formal-unavailable c) (formal-false c)))
      (and (o-stop x) (o-report x) (o-reason-formal x)
           (o-unmet x)
           (not (o-complete x)) (not (o-same-run-continue x))))
    (=> (and (Authoring (operation c))
             (nonformal-fail c) (o-stop x)
             (not (formal-unavailable c))
             (not (formal-false c)))
      (and (o-report x) (o-reason-ordinary x)
           (o-unmet x) (not (o-complete x))))
    (=> (and (Authoring (operation c))
             (nonformal-fail c) (o-complete x))
      (and (o-reverify x) (o-verification-pass x)))
    ; D035/O051: persistence failure has its own reason and logical scope.
    (=> (persist-fail c)
      (and (o-stop x) (o-report x) (not (o-complete x))
           (o-unsaved-scope x) (o-saved-retained x)))))
(define-fun SaveReasonDuty ((c Ctx) (x Out)) Bool
  (=> (persist-fail c) (o-reason-save x)))
(define-fun DecisionSlotDuty ((c Ctx) (x Out)) Bool
  (=> (missing-input c) (= (o-decision-slot x) present)))
(define-fun SourceDuty ((c Ctx) (x Out)) Bool
  (and (CoreDuty c x) (DecisionSlotDuty c x)
       (SaveReasonDuty c x)))

; Same concrete c is used for feasibility, compliance, and one-duty mutants.
(declare-const c Ctx)
(declare-const x Out)
(assert (= c (ctx create-op true true true false false false false true false
  known-absent known-absent known-absent)))
(echo "C01 Realizable input+save EXPECT sat")
(push) (assert (Realizable c)) (check-sat) (pop)
(echo "C02 Compliant same input+save EXPECT sat")
(push) (assert (Realizable c)) (assert (SourceDuty c x)) (check-sat) (pop)
(echo "C03 forbidden lost save reason EXPECT unsat")
(push) (assert (Realizable c)) (assert (SourceDuty c x))
  (assert (not (o-reason-save x))) (check-sat) (pop)
(echo "C04 mutant drop save-reason duty only EXPECT sat")
(push) (assert (Realizable c))
  (assert (CoreDuty c x))
  (assert (DecisionSlotDuty c x))
  (assert (not (o-reason-save x))) (check-sat) (pop)
(echo "C05 nonformal rewrite is choice, completion demands reverify EXPECT sat")
(push) (assert (Realizable (ctx create-op false false false false false false true false false
    known-absent known-absent known-absent)))
  (assert (SourceDuty (ctx create-op false false false false false false true false false
    known-absent known-absent known-absent) x))
  (assert (not (o-rewrite x))) (assert (not (o-complete x)))
  (check-sat) (pop)
(echo "S06 forbidden omitted nonexistent verification slot EXPECT unsat")
(push) (assert (Realizable c)) (assert (SourceDuty c x))
  (assert (= (o-verification-slot x) availability-unknown))
  (check-sat) (pop)
(echo "S06/S11 known-absent material remains reportable with unsaved report EXPECT sat")
(push) (assert (Realizable c)) (assert (SourceDuty c x))
  (assert (= (o-report-persistence x) unsaved))
  (assert (= (o-verification-slot x) known-absent))
  (assert (o-unsaved-scope x))
  (check-sat) (pop)
(echo "S06/S11 same source context also allows a saved report EXPECT sat")
(push) (assert (Realizable c)) (assert (SourceDuty c x))
  (assert (= (o-report-persistence x) saved))
  (check-sat) (pop)

; S08/S09: two ranked items (i0 before i1), cap=1, no response counts.
; The transition skeleton permits a faulty counter; SourceAttemptDuty rules it out.
(declare-datatypes ((CapState 0)) (((capstate (cap-run Run) (cap-epoch Epoch)
  (cap-count Int) (cap-limit Int) (cap-i0-unstarted Bool)
  (cap-i1-unstarted Bool) (cap-i0-result Bool) (cap-i1-result Bool)
  (cap-rank-i0 Int) (cap-rank-i1 Int)
  (cap-stopped Bool) (cap-episode Int)))))
(define-fun CapInitial ((s CapState)) Bool
  (and (= (cap-run s) old-run) (= (cap-epoch s) e0)
       (= (cap-count s) 0) (= (cap-limit s) 1)
       (cap-i0-unstarted s) (cap-i1-unstarted s)
       (not (cap-i0-result s)) (not (cap-i1-result s))
       (= (cap-rank-i0 s) 0) (= (cap-rank-i1 s) 1)
       (not (cap-stopped s)) (= (cap-episode s) 0)))
(define-fun AttemptNoResponseBase ((s CapState) (t CapState)) Bool
  (and (= (cap-run t) (cap-run s)) (= (cap-epoch t) (cap-epoch s))
       (= (cap-limit t) (cap-limit s)) (= (cap-episode t) (cap-episode s))
       (cap-i0-unstarted s) (not (cap-i0-unstarted t))
       (= (cap-i1-unstarted t) (cap-i1-unstarted s))
       (not (cap-i0-result t)) (= (cap-i1-result t) (cap-i1-result s))
       (= (cap-rank-i0 t) (cap-rank-i0 s))
       (= (cap-rank-i1 t) (cap-rank-i1 s))
       (not (cap-stopped t))
       (or (= (cap-count t) (cap-count s))
           (= (cap-count t) (+ (cap-count s) 1)))))
(define-fun SourceAttemptDuty ((s CapState) (t CapState)) Bool
  (and (= (cap-count t) (+ (cap-count s) 1))
       (<= (cap-count t) (cap-limit s))))
(define-fun CapStop ((s CapState) (t CapState)) Bool
  (and (= (cap-count s) (cap-limit s)) (cap-i1-unstarted s)
       (= (cap-run t) (cap-run s)) (= (cap-epoch t) (cap-epoch s))
       (= (cap-count t) (cap-count s)) (= (cap-limit t) (cap-limit s))
       (= (cap-i0-unstarted t) (cap-i0-unstarted s))
       (= (cap-i1-unstarted t) (cap-i1-unstarted s))
       (= (cap-i0-result t) (cap-i0-result s))
       (= (cap-i1-result t) (cap-i1-result s))
       (= (cap-rank-i0 t) (cap-rank-i0 s))
       (= (cap-rank-i1 t) (cap-rank-i1 s))
       (cap-stopped t) (= (cap-episode t) (+ (cap-episode s) 1))))
(define-fun CapNewRun ((s CapState) (t CapState)) Bool
  (and (cap-stopped s) (= (cap-run s) old-run)
       (= (cap-run t) current-run) (= (cap-epoch t) e1)
       (= (cap-count t) 0) (= (cap-limit t) (cap-limit s))
       (= (cap-i0-unstarted t) (cap-i0-unstarted s))
       (= (cap-i1-unstarted t) (cap-i1-unstarted s))
       (= (cap-i0-result t) (cap-i0-result s))
       (= (cap-i1-result t) (cap-i1-result s))
       (= (cap-rank-i0 t) (cap-rank-i0 s))
       (= (cap-rank-i1 t) (cap-rank-i1 s))
       (not (cap-stopped t)) (= (cap-episode t) (cap-episode s))))
(declare-const a0 CapState) (declare-const a1 CapState)
(declare-const a2 CapState) (declare-const a3 CapState)
(assert (CapInitial a0))
(assert (AttemptNoResponseBase a0 a1))
(echo "S08/S09 Reach initial→no-response→stop→new-run EXPECT sat")
(push) (assert (SourceAttemptDuty a0 a1)) (assert (CapStop a1 a2))
  (assert (CapNewRun a2 a3)) (check-sat)
  (get-value ((cap-count a0) (cap-count a1) (cap-count a2)
    (cap-count a3) (cap-i1-unstarted a2) (cap-i1-unstarted a3)
    (cap-rank-i1 a0) (cap-rank-i1 a2) (cap-rank-i1 a3))) (pop)
(echo "S08 forbidden response-only counter EXPECT unsat")
(push) (assert (SourceAttemptDuty a0 a1))
  (assert (= (cap-count a1) 0)) (check-sat) (pop)
(echo "S08 mutant omit count duty EXPECT sat")
(push) (assert (= (cap-count a1) 0)) (check-sat) (pop)
(echo "S09 forbidden carry old run count into new run EXPECT unsat")
(push) (assert (SourceAttemptDuty a0 a1))
  (assert (CapStop a1 a2)) (assert (CapNewRun a2 a3))
  (assert (= (cap-count a3) (cap-count a2)))
  (check-sat) (pop)

; S30: one Record contains all modeled semantic state. Rejected commands
; preserve the whole Record; only a separate receipt/result may differ.
(declare-datatypes ((Phase 0)) (((input-phase) (goal-fixing-phase)
  (goal-fixed-phase) (plan-phase) (execute-phase)
  (check-phase) (decide-phase) (report-phase))))
(define-fun Mask2 ((m Int)) Bool (and (<= 0 m) (<= m 3)))
(define-fun HasI0 ((m Int)) Bool (= (mod m 2) 1))
(define-fun HasI1 ((m Int)) Bool (<= 2 m))
(define-fun MaskSubset ((a Int) (b Int)) Bool
  (and (Mask2 a) (Mask2 b)
    (=> (HasI0 a) (HasI0 b))
    (=> (HasI1 a) (HasI1 b))))
(define-fun MaskDisjoint ((a Int) (b Int)) Bool
  (and (Mask2 a) (Mask2 b)
    (not (and (HasI0 a) (HasI0 b)))
    (not (and (HasI1 a) (HasI1 b)))))
(define-fun MaskUnion ((a Int) (b Int)) Int
  (+ (ite (or (HasI0 a) (HasI0 b)) 1 0)
     (ite (or (HasI1 a) (HasI1 b)) 2 0)))
(define-fun MaskDifference ((a Int) (b Int)) Int
  (+ (ite (and (HasI0 a) (not (HasI0 b))) 1 0)
     (ite (and (HasI1 a) (not (HasI1 b))) 2 0)))
(declare-datatypes ((Delivery 0)) (((delivery (d-run Run) (d-epoch Epoch)
  (d-id Int) (d-role Int) (d-phase Phase) (d-round Int) (d-hints Int)))))
(declare-datatypes ((Record 0)) (((record (rec-run Run) (rec-epoch Epoch)
  (rec-episode Int) (rec-phase Phase) (rec-round Int)
  (rec-item Int) (rec-remaining Int) (rec-rank-i0 Int)
  (rec-rank-i1 Int) (rec-reason Int) (rec-saved Int)
  (rec-history Int) (rec-plan Int) (rec-delivery Delivery)
  (rec-read Int) (rec-output-returned Bool)
  (rec-output-delivery Delivery) (rec-stop-phase Phase)
  (rec-unrecorded Int) (rec-recorded Int) (rec-blocked Bool)
  (rec-cause Int) (rec-input-content Int)
  (rec-stop-snapshot Int)))))
(define-fun WithRead ((s Record) (new-read Int)) Record
  (record (rec-run s) (rec-epoch s) (rec-episode s)
    (rec-phase s) (rec-round s) (rec-item s)
    (rec-remaining s) (rec-rank-i0 s) (rec-rank-i1 s)
    (rec-reason s) (rec-saved s) (rec-history s)
    (rec-plan s) (rec-delivery s) new-read
    (rec-output-returned s) (rec-output-delivery s)
    (rec-stop-phase s) (rec-unrecorded s) (rec-recorded s)
    (rec-blocked s) (rec-cause s) (rec-input-content s)
    (rec-stop-snapshot s)))
(define-fun WithOutput ((s Record) (d Delivery)) Record
  (record (rec-run s) (rec-epoch s) (rec-episode s)
    (rec-phase s) (rec-round s) (rec-item s)
    (rec-remaining s) (rec-rank-i0 s) (rec-rank-i1 s)
    (rec-reason s) (rec-saved s) (rec-history s)
    (rec-plan s) (rec-delivery s) (rec-read s) true d
    (rec-stop-phase s) (rec-unrecorded s) (rec-recorded s)
    (rec-blocked s) (rec-cause s) (rec-input-content s)
    (rec-stop-snapshot s)))
(define-fun RoleOutputReturned ((s Record) (t Record)
  (d Delivery)) Bool
  (and (not (rec-output-returned s)) (= t (WithOutput s d))))
(define-fun CommandDuty ((s Record) (t Record) (command-run Run)
  (command-epoch Epoch) (command-delivery Int)
  (command-role Int) (result StepResult)) Bool
  (ite (and (= command-run (rec-run s))
            (= command-epoch (rec-epoch s))
            (= command-delivery (d-id (rec-delivery s)))
            (= command-role (d-role (rec-delivery s)))
            (rec-output-returned s)
            (= (rec-output-delivery s) (rec-delivery s))
            (= (rec-phase s) (d-phase (rec-delivery s)))
            (= (rec-round s) (d-round (rec-delivery s))))
    (and (= result Accepted)
         (Mask2 (rec-read s))
         (Mask2 (d-hints (rec-delivery s)))
         (= t (WithRead s
           (MaskUnion (rec-read s) (d-hints (rec-delivery s))))))
    (and (= result Rejected) (= t s))))
(declare-const d0 Record) (declare-const dr Record)
(declare-const d1 Record) (declare-const d2 Record)
(declare-const old-result StepResult) (declare-const current-result StepResult)
(assert (= d0 (record current-run e1 1 execute-phase 4
  1 2 0 1 7 1 5 9
  (delivery current-run e1 1 2 execute-phase 4 3)
  0 false (delivery old-run e0 0 0 input-phase 0 0)
  execute-phase 2 1 false 0 100 17)))
(echo "S30 Reach output→old reject whole-record frame→current accept EXPECT sat")
(push) (assert (RoleOutputReturned d0 dr
    (delivery current-run e1 1 2 execute-phase 4 3)))
  (assert (CommandDuty dr d1 old-run e0 1 2 old-result))
  (assert (CommandDuty d1 d2 current-run e1 1 2 current-result))
  (check-sat) (get-value (old-result current-result (rec-read d1)
    (rec-read d2) (rec-reason d2) (rec-history d2)
    (rec-plan d2) (rec-item d2) (rec-remaining d2)
    (rec-stop-snapshot d1) (rec-stop-snapshot d2))) (pop)
(echo "S30 forbidden old command changes semantic record EXPECT unsat")
(push) (assert (RoleOutputReturned d0 dr
    (delivery current-run e1 1 2 execute-phase 4 3)))
  (assert (CommandDuty dr d1 old-run e0 1 2 old-result))
  (assert (not (= d1 dr))) (check-sat) (pop)
(echo "S30 forbidden wrong-role output accepted EXPECT unsat")
(push) (assert (RoleOutputReturned d0 dr
    (delivery current-run e1 1 9 execute-phase 4 3)))
  (assert (CommandDuty dr d1 current-run e1 1 2 current-result))
  (assert (= current-result Accepted)) (check-sat) (pop)
(echo "S30 mutant omit old reject whole-record duty EXPECT sat")
(push) (assert (RoleOutputReturned d0 dr
    (delivery current-run e1 1 2 execute-phase 4 3)))
  (assert (= (rec-run d1) (rec-run dr)))
  (assert (= (rec-delivery d1) (rec-delivery dr)))
  (assert (not (= d1 dr))) (check-sat) (pop)

; S32: old accepted fact is immutable; affected current eligibility is not.
(declare-datatypes ((EState 0)) (((es (es-run Run) (es-epoch Epoch)
  (es-old-accepted Bool) (es-dep-version Int) (es-affected-id Int)
  (es-unaffected-id Int) (es-affected-valid Bool)
  (es-unaffected-valid Bool) (es-affected-eligible Bool)
  (es-unaffected-eligible Bool) (es-use-affected Bool)
  (es-use-unaffected Bool)))))
(define-fun EvidenceFrame ((s EState) (t EState)) Bool
  (and (= (es-old-accepted s) (es-old-accepted t))
       (= (es-affected-id s) (es-affected-id t))
       (= (es-unaffected-id s) (es-unaffected-id t))))
(define-fun ChangedBase ((s EState) (t EState)) Bool
  (and (EvidenceFrame s t) (= (es-run t) current-run)
       (= (es-epoch t) e1) (= (es-dep-version t) (+ (es-dep-version s) 1))))
(define-fun ChangedDuty ((s EState) (t EState)) Bool
  (and (ChangedBase s t)
       (not (es-affected-valid t)) (not (es-affected-eligible t))
       (not (es-use-affected t))
       (= (es-unaffected-valid t) (es-unaffected-valid s))
       (= (es-unaffected-eligible t) (es-unaffected-eligible s))))
(define-fun ReverifyAffectedDuty ((s EState) (t EState)) Bool
  (and (EvidenceFrame s t) (= (es-run t) (es-run s))
       (= (es-epoch t) (es-epoch s))
       (= (es-dep-version t) (es-dep-version s))
       (not (es-affected-valid s)) (es-affected-valid t)
       (es-affected-eligible t)
       (= (es-unaffected-valid t) (es-unaffected-valid s))
       (= (es-unaffected-eligible t) (es-unaffected-eligible s))
       (= (es-use-unaffected t) (es-use-unaffected s))))
(declare-const e0s EState) (declare-const e1s EState)
(declare-const e2s EState)
(assert (= e0s (es old-run e0 true 0 11 12 true true true true false false)))
(echo "S32 Reach changed→invalid affected only→reverify; use optional EXPECT sat")
(push) (assert (ChangedDuty e0s e1s))
  (assert (ReverifyAffectedDuty e1s e2s))
  (assert (not (es-use-affected e2s)))
  (check-sat) (get-value ((es-old-accepted e2s) (es-affected-valid e1s)
    (es-unaffected-valid e1s) (es-affected-eligible e1s)
    (es-affected-eligible e2s) (es-use-affected e2s))) (pop)
(echo "S32 forbidden changed affected stays eligible EXPECT unsat")
(push) (assert (ChangedDuty e0s e1s))
  (assert (es-affected-eligible e1s)) (check-sat) (pop)
(echo "S32 mutant omit affected invalidation EXPECT sat")
(push) (assert (ChangedBase e0s e1s))
  (assert (es-affected-eligible e1s)) (check-sat) (pop)

; S33: origin (old run, old ID) is carried by groundRef; the current finding
; has its own ID. Old status is not imported as a current report status.
(declare-datatypes ((Ground 0)) (((ground (g-origin-run Run)
  (g-origin-finding Int) (g-id Int)))))
(declare-datatypes ((FState 0)) (((fs (fs-run Run) (fs-epoch Epoch)
  (fs-old-id Int) (fs-origin Ground) (fs-received Bool)
  (fs-current-id Int) (fs-current-ground Ground)
  (fs-evaluated Bool) (fs-current-status FindingStatus)
  (fs-report-old-status Bool) (fs-reported Bool)))))
(define-fun FIdentityFrame ((s FState) (t FState)) Bool
  (and (= (fs-run s) (fs-run t)) (= (fs-epoch s) (fs-epoch t))
       (= (fs-old-id s) (fs-old-id t)) (= (fs-origin s) (fs-origin t))
       (= (fs-current-id s) (fs-current-id t))
       (= (fs-current-ground s) (fs-current-ground t))))
(define-fun ReceiveGround ((s FState) (t FState)) Bool
  (and (FIdentityFrame s t) (not (fs-received s)) (fs-received t)
       (= (g-origin-run (fs-origin t)) old-run)
       (= (g-origin-finding (fs-origin t)) (fs-old-id t))
       (= (g-origin-run (fs-current-ground t)) old-run)
       (= (g-origin-finding (fs-current-ground t)) (fs-old-id t))
       (not (fs-evaluated t)) (not (fs-reported t))
       (= (fs-current-status t) no-current-status)
       (not (fs-report-old-status t))))
(define-fun EvaluateCurrent ((s FState) (t FState)) Bool
  (and (FIdentityFrame s t) (fs-received s)
       (not (= (fs-current-id s) (fs-old-id s)))
       (= (fs-received t) (fs-received s)) (fs-evaluated t)
       (not (= (fs-current-status t) no-current-status))
       (not (fs-report-old-status t)) (not (fs-reported t))))
(define-fun ReportCurrent ((s FState) (t FState)) Bool
  (and (FIdentityFrame s t) (fs-evaluated s)
       (= (fs-received t) (fs-received s))
       (= (fs-evaluated t) (fs-evaluated s))
       (= (fs-current-status t) (fs-current-status s))
       (not (fs-report-old-status t)) (fs-reported t)))
(declare-const f0 FState) (declare-const f1 FState)
(declare-const f2 FState) (declare-const f3 FState)
(assert (= f0 (fs current-run e1 41 (ground old-run 41 71)
  false 42 (ground old-run 41 72) false no-current-status false false)))
(echo "S33 Reach old ground→new ID evaluate→current status report EXPECT sat")
