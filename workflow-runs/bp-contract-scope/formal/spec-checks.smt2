(set-option :timeout 10000)
(set-option :produce-models true)
(set-logic ALL)
; Only public specification boundaries. Requirements are observations, not asserted conclusions.
(declare-datatypes () ((Fn Create Review Update Audit) (Host Native Codex) (Stop Complete NeedsInput Limit Blocked) (Judgment Conform Nonconform Unchecked ForcedUnchecked) (Verdict Passed Failed CannotVerify) (Cause None FormalFailed FormalUnrunnable Verifiers)))
(declare-const f0 Fn)
(declare-const f1 Fn)
(declare-const host Host)
(declare-const stop0 Stop)
(declare-const stop1 Stop)
(define-fun generated () Bool (or (= f0 Create) (= f0 Update)))
(declare-const preReject Bool)
(declare-const gDoc Bool)
(declare-const gHost Bool)
(declare-const gChain Bool)
(declare-const gWrite Bool)
(declare-const gResume Bool)
(declare-const gMin Bool)
(declare-const gReserve Bool)
(declare-const gFinish Bool)
(declare-const gPending Bool)
; C041 / F002: three finite candidate heading lines and two data rows.
(declare-const readable Bool)
(declare-const scope0 Bool)
(declare-const scope1 Bool)
(declare-const scope2 Bool)
(declare-const fence0 Bool)
(declare-const fence1 Bool)
(declare-const fence2 Bool)
(declare-const heading0 Bool)
(declare-const heading1 Bool)
(declare-const heading2 Bool)
(define-fun headingCount () Int (+ (ite (and scope0 (not fence0) heading0) 1 0) (ite (and scope1 (not fence1) heading1) 1 0) (ite (and scope2 (not fence2) heading2) 1 0)))
(declare-const separator Bool)
(declare-const rowCount Int)
(declare-const cells0 Int)
(declare-const cells1 Int)
(declare-const decision0Nonempty Bool)
(declare-const decision1Nonempty Bool)
(declare-const reason0Nonempty Bool)
(declare-const reason1Nonempty Bool)
(declare-const semanticBad Bool)
(declare-const enumerationIncomplete Bool)
(declare-const docResult Judgment)
(declare-const coverageRiskFields Int)
(declare-const coverageRiskCount Int)
(assert (and (<= 0 rowCount) (<= rowCount 2) (<= 0 cells0) (<= cells0 3) (<= 0 cells1) (<= cells1 3)))
(define-fun rowsValid () Bool (and (=> (> rowCount 0) (and (= cells0 2) decision0Nonempty reason0Nonempty)) (=> (> rowCount 1) (and (= cells1 2) decision1Nonempty reason1Nonempty))))
(assert (=> gDoc (= docResult (ite (not readable) Unchecked (ite (and (= headingCount 1) separator rowsValid) Conform Nonconform)))))
(assert (= coverageRiskFields 2))
(assert (= coverageRiskCount 1))
; Observation of D051 from the SAME header/data cells, not an asserted requirement.
(define-fun reqD051 () Bool (=> (= docResult Conform) (and (= headingCount 1) (or (and (= rowCount 0) separator) (and (> rowCount 0) rowsValid)) (=> (> rowCount 0) (and decision0Nonempty reason0Nonempty)) (=> (> rowCount 1) (and decision1Nonempty reason1Nonempty)))))
; C019/C020 / A046 / A023. Current list-derived bad limits and required-unit unknowns differ.
(declare-const ccDocReadable Bool)
(declare-const ccNamesPresent Bool)
(declare-const reliesIgnored0 Bool)
(declare-const reliesIgnored1 Bool)
(define-fun ccListRead () Bool (and ccDocReadable ccNamesPresent))
(define-fun ccKnownBad () Bool (and ccListRead (or reliesIgnored0 reliesIgnored1)))
(declare-const ccResult Judgment)
(declare-const ccCheckedCount Int)
(declare-const ccUnknownCount Int)
(declare-const codexUnknownCount Int)
(declare-const codexUnitUnchecked Bool)
(declare-const otherUnitUnchecked Bool)
(declare-const otherNonconform Bool)
(declare-const skipRemaining Bool)
(declare-const unrefuted Bool)
(declare-const missingConformanceResult Bool)
(declare-const authorVerdict Verdict)
(declare-const hostRiskFields Int)
(assert (= ccResult (ite ccListRead Conform ForcedUnchecked)))
(assert (= ccCheckedCount (ite ccListRead 2 0)))
(assert (= ccUnknownCount (ite ccListRead 0 2)))
(assert (= codexUnknownCount 2))
(assert (= hostRiskFields 4))
(assert (=> gHost (= authorVerdict (ite (or skipRemaining unrefuted missingConformanceResult) CannotVerify (ite (or ccKnownBad codexUnitUnchecked otherUnitUnchecked otherNonconform (= docResult Nonconform) (= docResult Unchecked)) Failed Passed)))))
(define-fun reqD046 () Bool (=> ccKnownBad (not (= authorVerdict Passed))))
(define-fun reqHostDisclosure () Bool (and (=> ccListRead (= ccUnknownCount 0)) (= codexUnknownCount 2) (= hostRiskFields 4)))
; E004/E007/E008/E009/E019/E020 repair1: occurrences, not function identities, are distinct.
(declare-const requestedA Fn)
(declare-const requestedB Fn)
(declare-const occurrence0 Int)
(declare-const occurrence1 Int)
(declare-const specified Bool)
(declare-const dep01 Bool)
(declare-const dep10 Bool)
(declare-const matches Bool)
(declare-const ask Bool)
(declare-const run0Started Bool)
(declare-const run0Returned Bool)
(declare-const run1Started Bool)
(declare-const returnedShapeValid Bool)
(declare-const groundsCount Int)
(declare-const calleeCreatedState Bool)
(assert (and (<= 0 occurrence0) (<= occurrence0 1) (= occurrence1 (- 1 occurrence0)) (<= 0 groundsCount) (<= groundsCount 3)))
(assert (= occurrence0 (ite (or specified dep01) 0 1)))
(assert (= f0 (ite (= occurrence0 0) requestedA requestedB)))
(assert (= f1 (ite (= occurrence1 0) requestedA requestedB)))
(assert (= ask (or (and specified dep10) (and (not specified) (= dep01 dep10)) (= f1 Create))))
(assert (= run0Started (and matches (not ask))))
(assert (=> gChain (=> run1Started (and run0Started run0Returned (= stop0 Complete) (or (not (and (= f1 Update) (or (= f0 Review) (= f0 Audit)))) returnedShapeValid)))))
(assert (=> (and run1Started (= f1 Update) (= groundsCount 0)) (and (= stop1 NeedsInput) (not calleeCreatedState))))
(assert (=> run1Started (not (= f1 Create))))
(assert (=> (and (= f0 Review) (= stop0 NeedsInput)) false))
(assert (=> (and (= f0 Audit) (= stop0 NeedsInput)) false))
(define-fun reqO038Stop () Bool (=> (or (not run0Returned) (not (= stop0 Complete))) (not run1Started)))
; R017/R014/R018/R035. A write is a different operation from issuing a resume.
(declare-const currentRun Int)
(declare-const requestRun Int)
(declare-const writeRequested Bool)
(declare-const stopRecordedForRequest Bool)
(declare-const isStopWrite Bool)
(declare-const sameStopPayload Bool)
(declare-const writeAccepted Bool)
(declare-const operationExecuted Bool)
(declare-const recordsBefore Int)
(declare-const recordsAfter Int)
(declare-const currentCauseBefore Int)
(declare-const currentCauseAfter Int)
(define-fun duplicateStop () Bool (and stopRecordedForRequest isStopWrite sameStopPayload))
(assert (and (<= 0 currentRun) (<= currentRun 1) (<= 0 requestRun) (<= requestRun 1) (<= 0 recordsBefore) (<= recordsBefore 3)))
(assert (= writeAccepted (and writeRequested (or duplicateStop (and (= requestRun currentRun) (not stopRecordedForRequest))))))
(assert (= operationExecuted (and writeAccepted (not duplicateStop))))
(assert (=> gWrite (= recordsAfter (+ recordsBefore (ite operationExecuted 1 0)))))
(assert (=> (not (= requestRun currentRun)) (= currentCauseAfter currentCauseBefore)))
(declare-const resumeRequested Bool)
(declare-const stateComplete Bool)
(declare-const stateReadable Bool)
(declare-const stateIdPresent Bool)
(declare-const newRunIssued Bool)
(declare-const previousRun Int)
(declare-const resumedRun Int)
(declare-const catalogListsResumable Bool)
(declare-const catalogUnreadIdDisclosed Bool)
(declare-const catalogUnreadReasonDisclosed Bool)
(assert (= catalogListsResumable (and stateReadable (not stateComplete))))
(assert (=> (not stateReadable) (and catalogUnreadIdDisclosed catalogUnreadReasonDisclosed)))
(assert (=> gResume (= newRunIssued (and resumeRequested stateIdPresent stateReadable (not stateComplete) (not preReject)))))
(assert (=> newRunIssued (and (= previousRun 0) (= resumedRun 1))))
; Three enumerated item IDs, independently launched/result/cut/discarded, not a launch-prefix shortcut.
(declare-const launched0 Bool)
(declare-const launched1 Bool)
(declare-const launched2 Bool)
(declare-const result0 Bool)
(declare-const result1 Bool)
(declare-const result2 Bool)
(declare-const cut0 Bool)
(declare-const cut1 Bool)
(declare-const cut2 Bool)
(declare-const discarded0 Bool)
(declare-const discarded1 Bool)
(declare-const discarded2 Bool)
(declare-const pending0 Bool)
(declare-const pending1 Bool)
(declare-const pending2 Bool)
(assert (=> gPending (and (= pending0 (and (not result0) (not cut0) (not discarded0))) (= pending1 (and (not result1) (not cut1) (not discarded1))) (= pending2 (and (not result2) (not cut2) (not discarded2))))))
(declare-const rank0 Int)
(declare-const rank1 Int)
(declare-const rank2 Int)
(declare-const resumeChoice Int)
(declare-const processPending Bool)
(assert (and (<= 0 rank0) (<= rank0 2) (<= 0 rank1) (<= rank1 2) (<= 0 rank2) (<= rank2 2) (distinct rank0 rank1 rank2)))
(define-fun chosenRank () Int (ite (= resumeChoice 0) rank0 (ite (= resumeChoice 1) rank1 rank2)))
(assert (=> processPending (and newRunIssued (<= 0 resumeChoice) (<= resumeChoice 2) (ite (= resumeChoice 0) pending0 (ite (= resumeChoice 1) pending1 pending2)) (=> pending0 (<= chosenRank rank0)) (=> pending1 (<= chosenRank rank1)) (=> pending2 (<= chosenRank rank2)))))
(define-fun reqPendingUnsaved () Bool (=> (and launched1 (not result1) (not cut1) (not discarded1)) pending1))
; R021/R037 + C022/R020. Public minimum table and shared capacity are separate rules.
(declare-const viaCallsite Bool)
(declare-const capProvided Bool)
(declare-const capInteger Bool)
(declare-const cap Int)
(declare-const isResume Bool)
(assert (=> isResume stateIdPresent))
(define-fun publicMin () Int (ite (= f0 Create) 31 (ite (= f0 Update) 32 (ite (= f0 Review) 33 28))))
(assert (=> viaCallsite (= capProvided (= host Codex))))
(assert (=> (and viaCallsite (= host Codex)) (= cap 1000)))
(assert (= preReject (and capProvided (or (not capInteger) (< cap 1) (< cap publicMin)))))
(declare-const agentCalls Int)
(declare-const stateCreated Bool)
(declare-const stateChangedBeforeLaunch Bool)
(declare-const nextArgsPresent Bool)
(declare-const capInNextArgs Bool)
(assert (=> gMin (=> preReject (and (= stop0 Blocked) (= agentCalls 0) (not stateCreated) (not stateChangedBeforeLaunch) (not writeRequested) (= nextArgsPresent stateIdPresent)))))
(assert (not capInNextArgs))
(declare-const activeRemaining Int)
(declare-const candidateCost0 Int)
(declare-const candidateCost1 Int)
(declare-const stopReserve Int)
(declare-const start0 Bool)
(declare-const start1 Bool)
(assert (and (<= 0 agentCalls) (<= agentCalls 1000) (<= 0 activeRemaining) (<= activeRemaining 40) (<= 0 candidateCost0) (<= candidateCost0 40) (<= 0 candidateCost1) (<= candidateCost1 40) (<= 0 stopReserve) (<= stopReserve 40)))
(define-fun projectedCalls () Int (+ agentCalls activeRemaining (ite start0 candidateCost0 0) (ite start1 candidateCost1 0) stopReserve))
(assert (=> (or start0 start1) (not preReject)))
(assert (=> (and gReserve capProvided (or start0 start1)) (<= projectedCalls cap)))
(define-fun reqBudget () Bool (=> (and capProvided (or start0 start1)) (<= projectedCalls cap)))
; A026/A044/A045 + R048. Completion, exact version, formal result, and storage share stop0.
(declare-const targetVersion Int)
(declare-const formalVersion Int)
(declare-const formalSaved Bool)
(declare-const formalStage Bool)
(declare-const verifierReturned Bool)
(declare-const extracted Bool)
(declare-const propertyCount Int)
(declare-const hasCounterexample Bool)
(declare-const hasUnrunnable Bool)
(declare-const nonformalUnconfirmed Bool)
(declare-const saveFailed Bool)
(declare-const evidenceBefore Bool)
(declare-const evidenceAfter Bool)
(declare-const rewriteSameRun Bool)
(declare-const formalCause Cause)
(assert (and (<= 0 targetVersion) (<= targetVersion 1) (<= 0 formalVersion) (<= formalVersion 1) (<= 0 propertyCount) (<= propertyCount 2)))
(assert (=> (or hasCounterexample hasUnrunnable nonformalUnconfirmed) (> propertyCount 0)))
(define-fun formalPass () Bool (and verifierReturned extracted (not hasCounterexample) (not hasUnrunnable)))
(assert (= formalCause (ite saveFailed None (ite (not verifierReturned) Verifiers (ite (not extracted) FormalUnrunnable (ite hasCounterexample FormalFailed (ite hasUnrunnable FormalUnrunnable None)))))))
(assert (=> (and formalStage (not formalPass)) (and (= stop0 Blocked) (not rewriteSameRun))))
(assert (=> saveFailed (and (= stop0 Blocked) (=> evidenceBefore evidenceAfter))))
(assert (=> (and gFinish generated (= stop0 Complete)) (and (= authorVerdict Passed) formalPass formalSaved (= targetVersion formalVersion) (not saveFailed))))
(define-fun reqCompleteVerified () Bool (=> (and generated (= stop0 Complete)) (and (= authorVerdict Passed) formalPass formalSaved (= targetVersion formalVersion))))
(define-fun reqSaveFailure () Bool (=> saveFailed (and (not (= stop0 Complete)) (=> evidenceBefore evidenceAfter))))

; Expectations fixed before executing solver; guards only disable one named rule per mutant.
(echo "all-spec.consistency expected=sat")
(push)
(assert true)
(check-sat-assuming (gDoc gHost gChain gWrite gResume gMin gReserve gFinish gPending))
(pop)
(echo "doc.normal.empty expected=sat")
(push)
(assert (and readable scope0 heading0 (not fence0) (not heading1) (not heading2) separator (= rowCount 0) (= docResult Conform) semanticBad enumerationIncomplete))
(check-sat-assuming (gDoc gHost gChain gWrite gResume gMin gReserve gFinish gPending))
(get-value (headingCount rowCount docResult semanticBad enumerationIncomplete coverageRiskFields coverageRiskCount))
(pop)
(echo "doc.normal.fenced-or-outside expected=sat")
(push)
(assert (and readable scope0 heading0 (not fence0) scope1 heading1 fence1 (not scope2) heading2 separator (= rowCount 1) (= cells0 2) decision0Nonempty reason0Nonempty (= docResult Conform)))
(check-sat-assuming (gDoc gHost gChain gWrite gResume gMin gReserve gFinish gPending))
(get-value (headingCount fence1 scope2 rowCount cells0 docResult))
(pop)
(echo "doc.normal.multiple expected=sat")
