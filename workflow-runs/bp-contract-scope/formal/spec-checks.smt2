(assert (and readable scope0 heading0 (not fence0) scope1 heading1 (not fence1)))
(check-sat-assuming (gDoc gHost gChain gWrite gResume gMin gReserve gFinish gPending))
(get-value (headingCount docResult))
(pop)
(echo "doc.normal.unreadable expected=sat")
