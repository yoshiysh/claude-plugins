(set-logic QF_AUFLIA)
(set-option :timeout 10000)
; Bounded abstraction: two planned jobs, at most two runs; caller supplies the step bound.
; A job is 0 not started, 1 pending, 2 passed, 3 counterexample, 4 unknown,
; 5 timeout, or 6 error. Terminal job status means the job returned, not that it passed.
; phase: 0 running, 1 stopped, 2 complete. No real files or real external processes.
(declare-const bad_complete Bool)
(declare-const bad_report_poststop Bool)
(declare-fun postStopSaveFailed (Int) Bool)
(declare-fun outPostStopSaveFailed (Int) Bool)
(declare-const bad_stale_ledger Bool)
(declare-const bad_report_ledger_current Bool)
(declare-fun workRevision (Int) Int)
(declare-fun ledgerRevision (Int) Int)
(declare-fun outLedgerCurrent (Int) Bool)
(declare-const bad_state_ref Bool)
(declare-fun stateSaved (Int) Bool)
(declare-fun chooseStateSaved (Int) Bool)
(declare-const bad_report_done Bool)
(declare-const bad_report_unstarted Bool)
(declare-const bad_report_pending Bool)
(declare-const bad_report_unknown Bool)
(declare-const bad_report_unsaved Bool)
(declare-const bad_resume_reference Bool)
(declare-const bad_resume_inputs Bool)
(declare-const bad_no_reason Bool)
(declare-const bad_resume_position Bool)
(declare-const bad_resume_early Bool)
(declare-const bad_archive Bool)
(declare-const bad_review_early Bool)
(declare-const bad_review_independence Bool)
(declare-const bad_report_reviewer Bool)
(declare-fun reviewBy (Int) Int)
(declare-fun chooseReviewer (Int) Int)
(declare-fun outReviewBy (Int) Int)
(declare-const bad_report_review Bool)
(declare-const bad_report_ledger Bool)
(declare-const bad_report_timeout Bool)
(declare-const bad_report_error Bool)
(declare-const bad_report_counterexample Bool)
(declare-const bad_report_stop_reason Bool)
(declare-fun archive (Int) Bool)
(declare-fun phase (Int) Int)
(declare-fun run (Int) Int)
(declare-fun jobs (Int) (Array Int Int))
(declare-fun saved (Int) (Array Int Bool))
(declare-fun review (Int) Int)
(declare-fun ledgerSaved (Int) Bool)
(declare-fun aggregated (Int) Bool)
(declare-fun aggregate (Int) (Array Int Int))
(declare-fun stopReason (Int) Int)
(declare-fun canResume (Int) Bool)
(declare-fun stateRef (Int) Int)
(declare-fun resumePosition (Int) Int)
(declare-fun needInput (Int) Bool)
(declare-fun needEnv (Int) Bool)
(declare-fun reasonNoResume (Int) Int)
(declare-fun inputReady (Int) Bool)
(declare-fun envReady (Int) Bool)
(declare-fun reportDone (Int) Bool)
(declare-fun outDone (Int) Int)
(declare-fun outUnstarted (Int) Int)
(declare-fun outPending (Int) Int)
(declare-fun outUnknown (Int) Int)
(declare-fun outCounterexample (Int) Int)
(declare-fun outTimeout (Int) Int)
(declare-fun outError (Int) Int)
(declare-fun outReview (Int) Int)
(declare-fun outLedgerSaved (Int) Bool)
(declare-fun outAggregated (Int) Bool)
(declare-fun outUnsaved (Int) Int)
(declare-fun outUnconfirmed (Int) Int)
(declare-fun outStopReason (Int) Int)
(declare-fun outCanResume (Int) Bool)
(declare-fun outRef (Int) Int)
(declare-fun outPosition (Int) Int)
(declare-fun outNeedInput (Int) Bool)
(declare-fun outNeedEnv (Int) Bool)
(declare-fun outNoResumeReason (Int) Int)
(declare-fun position (Int) Int)
(declare-fun event (Int) Int)
(declare-fun eventJob (Int) Int)
(declare-fun eventResult (Int) Int)
(declare-fun chooseResume (Int) Bool)
(declare-fun choosePosition (Int) Int)
(declare-fun chooseInput (Int) Bool)
(declare-fun chooseEnv (Int) Bool)
(declare-fun chooseNoResumeReason (Int) Int)
(define-fun mask ((p0 Bool) (p1 Bool)) Int (+ (ite p0 1 0) (ite p1 2 0)))
(define-fun doneMask ((t Int)) Int (mask (>= (select (jobs t) 0) 2) (>= (select (jobs t) 1) 2)))
(define-fun unstartedMask ((t Int)) Int (mask (= (select (jobs t) 0) 0) (= (select (jobs t) 1) 0)))
(define-fun pendingMask ((t Int)) Int (mask (= (select (jobs t) 0) 1) (= (select (jobs t) 1) 1)))
(define-fun unknownMask ((t Int)) Int (mask (= (select (jobs t) 0) 4) (= (select (jobs t) 1) 4)))
(define-fun counterexampleMask ((t Int)) Int (mask (= (select (jobs t) 0) 3) (= (select (jobs t) 1) 3)))
(define-fun timeoutMask ((t Int)) Int (mask (= (select (jobs t) 0) 5) (= (select (jobs t) 1) 5)))
(define-fun errorMask ((t Int)) Int (mask (= (select (jobs t) 0) 6) (= (select (jobs t) 1) 6)))
(define-fun unsavedMask ((t Int)) Int (mask (and (>= (select (jobs t) 0) 2) (not (select (saved t) 0))) (and (>= (select (jobs t) 1) 2) (not (select (saved t) 1)))))
(define-fun unconfirmedMask ((t Int)) Int (mask (not (= (select (jobs t) 0) 2)) (not (= (select (jobs t) 1) 2))))
(define-fun report-frame ((t Int) (n Int)) Bool
 (and (= (reportDone n) (reportDone t)) (= (outDone n) (outDone t)) (= (outUnstarted n) (outUnstarted t))
 (= (outPending n) (outPending t)) (= (outUnknown n) (outUnknown t))
 (= (outCounterexample n) (outCounterexample t)) (= (outTimeout n) (outTimeout t)) (= (outError n) (outError t))
 (= (outPostStopSaveFailed n) (outPostStopSaveFailed t)) (= (outReview n) (outReview t)) (= (outReviewBy n) (outReviewBy t)) (= (outLedgerCurrent n) (outLedgerCurrent t)) (= (outLedgerSaved n) (outLedgerSaved t)) (= (outAggregated n) (outAggregated t)) (= (outUnsaved n) (outUnsaved t))
 (= (outUnconfirmed n) (outUnconfirmed t)) (= (outStopReason n) (outStopReason t)) (= (outCanResume n) (outCanResume t))
 (= (outRef n) (outRef t)) (= (outPosition n) (outPosition t)) (= (outNeedInput n) (outNeedInput t))
 (= (outNeedEnv n) (outNeedEnv t)) (= (outNoResumeReason n) (outNoResumeReason t))))
(define-fun resume-frame ((t Int) (n Int)) Bool
 (and (= (stopReason n) (stopReason t)) (= (canResume n) (canResume t)) (= (stateRef n) (stateRef t))
 (= (resumePosition n) (resumePosition t)) (= (needInput n) (needInput t)) (= (needEnv n) (needEnv t))
 (= (reasonNoResume n) (reasonNoResume t)) (= (inputReady n) (inputReady t)) (= (envReady n) (envReady t))
 (= (position n) (position t))))
(define-fun work-frame ((t Int) (n Int)) Bool
 (and (= (jobs n) (jobs t)) (= (saved n) (saved t)) (= (review n) (review t)) (= (ledgerSaved n) (ledgerSaved t))
 (= (aggregated n) (aggregated t)) (= (aggregate n) (aggregate t))))
; Stop input is deliberately abstract: it declares the recoverability and required inputs.
; The chosen position/conditions are *assumptions*, not proven from the user request.
(define-fun stop-data ((t Int) (n Int) (why Int)) Bool
 (and (= (stopReason n) why) (= (canResume n) (chooseResume t))
 ; At the two-run model boundary, a third run is outside scope; code 2 denotes that boundary.
 (=> (= (run t) 1) (and (not (chooseResume t)) (= (chooseNoResumeReason t) 2)))
 (=> (and (chooseResume t) (not bad_state_ref)) (chooseStateSaved t))
 (= (stateRef n) (ite (or (chooseStateSaved t) (and bad_state_ref (chooseResume t))) (+ 1 (run t)) 0))
 (<= 1 (choosePosition t)) (<= (choosePosition t) 2) (= (resumePosition n) (choosePosition t))
 (= (needInput n) (chooseInput t)) (= (needEnv n) (chooseEnv t))
 (=> (not (chooseResume t)) (and (<= 1 (chooseNoResumeReason t)) (<= (chooseNoResumeReason t) 2)))
 (= (reasonNoResume n) (ite (chooseResume t) 0 (chooseNoResumeReason t)))
 (= (inputReady n) (not (chooseInput t))) (= (envReady n) (not (chooseEnv t))) (= (position n) (position t))))
(define-fun init () Bool
 (and (not (postStopSaveFailed 0)) (not (outPostStopSaveFailed 0)) (= (workRevision 0) 0) (= (ledgerRevision 0) -1) (not (outLedgerCurrent 0)) (not (stateSaved 0)) (= (reviewBy 0) -1) (= (outReviewBy 0) -1) (not (archive 0)) (= (phase 0) 0) (= (run 0) 0)
  (= (jobs 0) (store (store ((as const (Array Int Int)) 0) 0 1) 1 1))
  (= (saved 0) ((as const (Array Int Bool)) false)) (= (review 0) 0) (not (ledgerSaved 0))
  (not (aggregated 0)) (= (aggregate 0) ((as const (Array Int Int)) 0))
  (= (stopReason 0) 0) (not (canResume 0)) (= (stateRef 0) 0) (= (resumePosition 0) 0)
  (not (needInput 0)) (not (needEnv 0)) (= (reasonNoResume 0) 0) (not (inputReady 0)) (not (envReady 0)) (= (position 0) 1)
  (not (reportDone 0)) (= (outDone 0) 0) (= (outUnstarted 0) 0) (= (outPending 0) 0) (= (outUnknown 0) 0)
  (= (outCounterexample 0) 0) (= (outTimeout 0) 0) (= (outError 0) 0) (= (outReview 0) 0) (not (outLedgerSaved 0)) (not (outAggregated 0))
  (= (outUnsaved 0) 0) (= (outUnconfirmed 0) 0) (= (outStopReason 0) 0) (not (outCanResume 0))
  (= (outRef 0) 0) (= (outPosition 0) 0) (not (outNeedInput 0)) (not (outNeedEnv 0)) (= (outNoResumeReason 0) 0)))
; event 0: result; 1: save result; 2: independent semantic review;
; 3: save ledger; 4: aggregate; 5: complete; 6: external stop; 7: report;
; 8/9: input/environment ready; 10: resume; 11: stutter; 12: set job unstarted (initial fixture); 13: ledger save failure.
(define-fun step ((t Int) (n Int)) Bool
 (or
 ; A result may arrive after a stop and before reporting. Post-report results are outside this model; this is not a product rule.
 (and (= (event t) 0) (or (= (phase t) 0) (and (= (phase t) 1) (not (reportDone t))))
   (<= 0 (eventJob t)) (<= (eventJob t) 1) (= (select (jobs t) (eventJob t)) 1)
   (<= 2 (eventResult t)) (<= (eventResult t) 6) (= (run n) (run t))
   (= (jobs n) (store (jobs t) (eventJob t) (eventResult t))) (= (saved n) (saved t)) (= (review n) (review t))
   (= (ledgerSaved n) (ledgerSaved t)) (not (aggregated n)) (= (aggregate n) (aggregate t)) (report-frame t n)
   (ite (and (= (phase t) 0) (> (eventResult t) 2))
     (and (= (phase n) 1) (stop-data t n (eventResult t)))
     (and (= (phase n) (phase t)) (resume-frame t n))))
 ; Save only an actual returned result; saving failure is a separate external-stop reason.
 (and (= (event t) 1) (not (= (phase t) 2)) (not (reportDone t))
   (<= 0 (eventJob t)) (<= (eventJob t) 1) (>= (select (jobs t) (eventJob t)) 2)
   (not (select (saved t) (eventJob t))) (= (saved n) (store (saved t) (eventJob t) true))
   (= (jobs n) (jobs t)) (= (phase n) (phase t)) (= (run n) (run t)) (= (review n) (review t))
   (= (ledgerSaved n) (ledgerSaved t)) (= (aggregated n) (aggregated t)) (= (aggregate n) (aggregate t))
   (resume-frame t n) (report-frame t n))
 ; An independent review result and its saved record are one atomic abstract event.
 ; This is a modelling assumption, not a claim that real-world writes are atomic.
 ; A failed review-record save is a separate stop event below. Context identity is abstracted.
 (and (= (event t) 2) (= (phase t) 0) (= (review t) 0) (= (review n) 1)
   (<= 0 (chooseReviewer t)) (<= (chooseReviewer t) 1)
   (or bad_review_independence (= (chooseReviewer t) 1))
   (or bad_review_early (and (= (select (jobs t) 0) 2) (= (select (jobs t) 1) 2)
       (select (saved t) 0) (select (saved t) 1) (aggregated t)
       (= (select (aggregate t) 0) 2) (= (select (aggregate t) 1) 2)))
   (= (phase n) (phase t)) (= (run n) (run t)) (= (jobs n) (jobs t)) (= (saved n) (saved t))
   (= (ledgerSaved n) (ledgerSaved t)) (= (aggregated n) (aggregated t)) (= (aggregate n) (aggregate t))
   (resume-frame t n) (report-frame t n))
 (and (= (event t) 3) (= (phase t) 0)
   (or (not (ledgerSaved t)) (not (= (ledgerRevision t) (workRevision t)))) (ledgerSaved n)
   (= (phase n) (phase t)) (= (run n) (run t)) (= (jobs n) (jobs t)) (= (saved n) (saved t)) (= (review n) (review t))
   (= (aggregated n) (aggregated t)) (= (aggregate n) (aggregate t)) (resume-frame t n) (report-frame t n))
 (and (= (event t) 4) (= (phase t) 0) (not (aggregated t)) (aggregated n) (= (aggregate n) (jobs t))
   (= (phase n) (phase t)) (= (run n) (run t)) (= (jobs n) (jobs t)) (= (saved n) (saved t))
   (= (review n) (review t)) (= (ledgerSaved n) (ledgerSaved t)) (resume-frame t n) (report-frame t n))
 (and (= (event t) 5) (= (phase t) 0)
   (or bad_complete (and (= (select (jobs t) 0) 2) (= (select (jobs t) 1) 2)
       (select (saved t) 0) (select (saved t) 1) (= (review t) 1) (ledgerSaved t)
       (or bad_stale_ledger (= (ledgerRevision t) (workRevision t))) (aggregated t) (= (select (aggregate t) 0) 2) (= (select (aggregate t) 1) 2)))
   (= (phase n) 2) (= (run n) (run t)) (work-frame t n) (resume-frame t n) (report-frame t n))
 ; External stop encompasses model/record failure and is not a success.
 ; Event 14 abstracts a failed independent-review record save.
 (and (or (= (event t) 6) (= (event t) 13) (= (event t) 14)) (= (phase t) 0)
   (=> (= (event t) 13) (or (not (ledgerSaved t)) (not (= (ledgerRevision t) (workRevision t)))))
   (=> (= (event t) 14) (= (review t) 0)) (= (phase n) 1) (= (run n) (run t))
   (stop-data t n (ite (= (event t) 13) 8 (ite (= (event t) 14) 9 7))) (work-frame t n) (report-frame t n))
 ; Report fields are a snapshot. The fault flags intentionally omit one output.
 (and (= (event t) 7) (= (phase t) 1) (not (reportDone t)) (= (phase n) 1) (= (run n) (run t))
   (reportDone n) (= (outDone n) (ite bad_report_done 0 (doneMask t)))
   (= (outUnstarted n) (ite bad_report_unstarted 0 (unstartedMask t)))
   (= (outPending n) (ite bad_report_pending 0 (pendingMask t)))
   (= (outUnknown n) (ite bad_report_unknown 0 (unknownMask t)))
   (= (outCounterexample n) (ite bad_report_counterexample 0 (counterexampleMask t)))
   (= (outTimeout n) (ite bad_report_timeout 0 (timeoutMask t))) (= (outError n) (ite bad_report_error 0 (errorMask t)))
   (= (outPostStopSaveFailed n) (and (not bad_report_poststop) (postStopSaveFailed t)))
   (= (outReview n) (ite bad_report_review 0 (review t)))
   (= (outReviewBy n) (ite bad_report_reviewer -1 (reviewBy t))) (= (outLedgerSaved n) (and (not bad_report_ledger) (ledgerSaved t)))
   (= (outAggregated n) (aggregated t))
   (= (outLedgerCurrent n) (ite bad_report_ledger_current true
       (and (ledgerSaved t) (= (ledgerRevision t) (workRevision t)))))
   (= (outUnsaved n) (ite bad_report_unsaved 0 (unsavedMask t))) (= (outUnconfirmed n) (unconfirmedMask t))
   (= (outStopReason n) (ite bad_report_stop_reason 0 (stopReason t))) (= (outCanResume n) (canResume t))
   (= (outRef n) (ite bad_resume_reference 0 (stateRef t))) (= (outPosition n) (resumePosition t))
   (= (outNeedInput n) (ite bad_resume_inputs false (needInput t))) (= (outNeedEnv n) (ite bad_resume_inputs false (needEnv t)))
   (= (outNoResumeReason n) (ite bad_no_reason 0 (reasonNoResume t))) (resume-frame t n) (work-frame t n))
 (and (= (event t) 8) (= (phase t) 1) (not (inputReady t)) (inputReady n) (= (envReady n) (envReady t))
   (= (phase n) 1) (= (run n) (run t)) (= (stopReason n) (stopReason t)) (= (canResume n) (canResume t)) (= (stateRef n) (stateRef t))
   (= (resumePosition n) (resumePosition t)) (= (needInput n) (needInput t)) (= (needEnv n) (needEnv t))
   (= (reasonNoResume n) (reasonNoResume t)) (= (position n) (position t)) (work-frame t n) (report-frame t n))
 (and (= (event t) 9) (= (phase t) 1) (not (envReady t)) (envReady n) (= (inputReady n) (inputReady t))
   (= (phase n) 1) (= (run n) (run t)) (= (stopReason n) (stopReason t)) (= (canResume n) (canResume t)) (= (stateRef n) (stateRef t))
   (= (resumePosition n) (resumePosition t)) (= (needInput n) (needInput t)) (= (needEnv n) (needEnv t))
   (= (reasonNoResume n) (reasonNoResume t)) (= (position n) (position t)) (work-frame t n) (report-frame t n))
 (and (= (event t) 10) (= (phase t) 1) (= (run t) 0)
   (or bad_resume_early (and (reportDone t) (canResume t) (inputReady t) (envReady t)))
   (= (phase n) 0) (= (run n) 1) (= (position n) (ite bad_resume_position 0 (resumePosition t)))
   (= (jobs n) (store (store ((as const (Array Int Int)) 0) 0 1) 1 1)) (= (saved n) ((as const (Array Int Bool)) false))
   (= (review n) 0) (not (ledgerSaved n)) (not (= (ledgerRevision n) (workRevision n))) (not (aggregated n)) (= (aggregate n) ((as const (Array Int Int)) 0))
   (= (stopReason n) 0) (not (canResume n)) (= (stateRef n) 0) (= (resumePosition n) 0)
   (not (needInput n)) (not (needEnv n)) (= (reasonNoResume n) 0) (not (inputReady n)) (not (envReady n))
   ; The abstract archive retains existence of an old report, not the report contents.
   (not (reportDone n)) (= (outDone n) 0) (= (outUnstarted n) 0) (= (outPending n) 0)
   (= (outUnknown n) 0) (= (outCounterexample n) 0) (= (outTimeout n) 0) (= (outError n) 0)
   (not (outPostStopSaveFailed n)) (= (outReview n) 0) (= (outReviewBy n) -1) (not (outLedgerSaved n)) (not (outLedgerCurrent n)) (not (outAggregated n)) (= (outUnsaved n) 0) (= (outUnconfirmed n) 0) (= (outStopReason n) 0)
   (not (outCanResume n)) (= (outRef n) 0) (= (outPosition n) 0) (not (outNeedInput n))
   (not (outNeedEnv n)) (= (outNoResumeReason n) 0))
 ; A record-save failure after stopping is reported in addition to the original stop reason.
 (and (= (event t) 15) (= (phase t) 1) (not (reportDone t)) (not (postStopSaveFailed t))
   (= (phase n) 1) (= (run n) (run t)) (work-frame t n) (resume-frame t n) (report-frame t n))
 (and (= (event t) 11) (= (phase n) (phase t)) (= (run n) (run t)) (work-frame t n) (resume-frame t n) (report-frame t n))
 ; Fixture for an unstarted job; only at initial state, before any result.
 (and (= (event t) 12) (= t 0) (= (phase t) 0) (= (review t) 0)
   (not (ledgerSaved t)) (not (aggregated t)) (= (select (jobs t) 0) 1) (= (select (jobs t) 1) 1)
   (not (select (saved t) 0)) (not (select (saved t) 1)) (<= 0 (eventJob t)) (<= (eventJob t) 1)
   (= (jobs n) (store (jobs t) (eventJob t) 0)) (= (phase n) (phase t)) (= (run n) (run t))
   (= (saved n) (saved t)) (= (review n) (review t)) (= (ledgerSaved n) (ledgerSaved t))
   (= (aggregated n) (aggregated t)) (= (aggregate n) (aggregate t)) (resume-frame t n) (report-frame t n))))
; A distinct abstract archive existence bit persists when a reported run is resumed.
; It does not model durable bytes, lookup, deletion, or storage failure.
(define-fun next ((t Int) (n Int)) Bool
 (and (step t n)
      (= (postStopSaveFailed n) (ite (= (event t) 10) false (or (postStopSaveFailed t) (= (event t) 15))))
      (= (workRevision n) (ite (= (event t) 10) 0
          (ite (or (= (event t) 0) (= (event t) 1) (= (event t) 2) (= (event t) 4)) (+ (workRevision t) 1) (workRevision t))))
      (= (ledgerRevision n) (ite (= (event t) 10) -1
          (ite (= (event t) 3) (workRevision t) (ledgerRevision t))))
      (= (stateSaved n) (ite (or (= (event t) 6) (= (event t) 13) (= (event t) 14)
                                  (and (= (event t) 0) (= (phase t) 0) (> (eventResult t) 2)))
                             (chooseStateSaved t) (ite (= (event t) 10) false (stateSaved t))))
      (= (reviewBy n) (ite (= (event t) 2) (chooseReviewer t) (ite (= (event t) 10) -1 (reviewBy t))))
      (= (archive n) (and (not bad_archive) (or (archive t) (and (= (event t) 10) (reportDone t)))))))
; Independent oracles inspect requirements, not the enabling guards of complete/report.
(define-fun bad-done ((n Int)) Bool
 (and (= (phase n) 2) (or (not (= (select (jobs n) 0) 2)) (not (= (select (jobs n) 1) 2))
 (not (select (saved n) 0)) (not (select (saved n) 1)) (not (= (review n) 1)) (not (= (reviewBy n) 1))
 (not (ledgerSaved n)) (not (= (ledgerRevision n) (workRevision n))) (not (aggregated n)) (not (= (select (aggregate n) 0) 2)) (not (= (select (aggregate n) 1) 2)))))
; Reporting oracle decodes each output bit independently of the mask-building functions.
(define-fun hasBit ((m Int) (j Int)) Bool (ite (= j 0) (= (mod m 2) 1) (= (mod (div m 2) 2) 1)))
(define-fun reportJobOK ((t Int) (n Int) (j Int)) Bool
 (and (= (hasBit (outDone n) j) (>= (select (jobs t) j) 2))
      (= (hasBit (outUnstarted n) j) (= (select (jobs t) j) 0))
      (= (hasBit (outPending n) j) (= (select (jobs t) j) 1))
      (= (hasBit (outUnknown n) j) (= (select (jobs t) j) 4))
      (= (hasBit (outCounterexample n) j) (= (select (jobs t) j) 3))
      (= (hasBit (outTimeout n) j) (= (select (jobs t) j) 5))
      (= (hasBit (outError n) j) (= (select (jobs t) j) 6))
      (= (hasBit (outUnsaved n) j) (and (>= (select (jobs t) j) 2) (not (select (saved t) j))))
      (= (hasBit (outUnconfirmed n) j) (not (= (select (jobs t) j) 2)))))
(define-fun bad-report ((t Int) (n Int)) Bool
 (and (= (event t) 7)
  (or (not (reportJobOK t n 0)) (not (reportJobOK t n 1))
      (not (= (outPostStopSaveFailed n) (postStopSaveFailed t)))
      (not (= (outReview n) (review t))) (not (= (outReviewBy n) (reviewBy t))) (not (= (outLedgerSaved n) (ledgerSaved t))) (not (= (outAggregated n) (aggregated t)))
      (not (= (outLedgerCurrent n) (and (ledgerSaved t) (= (ledgerRevision t) (workRevision t)))))
      (not (= (outStopReason n) (stopReason t))) (not (= (outCanResume n) (canResume t)))
      (ite (canResume t)
       (or (not (stateSaved t)) (<= (outRef n) 0) (not (= (outRef n) (stateRef t))) (not (= (outPosition n) (resumePosition t)))
           (not (= (outNeedInput n) (needInput t))) (not (= (outNeedEnv n) (needEnv t))))
       (or (= (outNoResumeReason n) 0) (not (= (outNoResumeReason n) (reasonNoResume t))))))))
; The author has ID 0. A review must be by the other context and after all results/records exist.
(define-fun bad-review ((t Int) (n Int)) Bool
 (and (= (event t) 2) (or (not (= (reviewBy n) 1))
  (not (= (select (jobs t) 0) 2)) (not (= (select (jobs t) 1) 2))
  (not (select (saved t) 0)) (not (select (saved t) 1))
  (not (aggregated t))
  (not (= (select (aggregate t) 0) 2)) (not (= (select (aggregate t) 1) 2)))))
(define-fun bad-resume ((t Int) (n Int)) Bool
 (and (= (event t) 10)
   (or (not (reportDone t)) (not (canResume t)) (not (stateSaved t)) (not (inputReady t)) (not (envReady t))
       (not (= (run n) 1)) (not (= (position n) (resumePosition t))) (not (archive n)))))
(assert init)
