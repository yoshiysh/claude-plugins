(set-logic QF_LIA)
; Boundary stages: 0 untouched, 1 temp created, 2 written, 3 synced,
; 4 rename published, 5 directory synced. Atomic rename is an assumption.
(declare-const stage Int)
(declare-const previous Int)
(declare-const proposed Int)
(declare-const recovered Int)
(declare-const acknowledged Bool)
(declare-const user_delete Bool)
(declare-const deleted Bool)
(declare-const report_before Int)
(declare-const report_after Int)
(declare-const bad_early_ack Bool)
(declare-const bad_precommit_replace Bool)
(declare-const bad_report_replace Bool)
(declare-const bad_auto_delete Bool)
(assert (and (<= 0 stage) (<= stage 5)))
(assert (= recovered (ite (or (>= stage 4) (and bad_precommit_replace (= stage 2))) proposed previous)))
(assert (= acknowledged (or (= stage 5) (and bad_early_ack (= stage 3)))))
(assert (= report_after (ite bad_report_replace (+ report_before 1) report_before)))
(assert (= deleted (or user_delete bad_auto_delete)))
