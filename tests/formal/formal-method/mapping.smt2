(set-logic QF_BV)
(set-option :timeout 10000)
; Two required requirements, two properties, two target IDs and two scope atoms.
(declare-const required0 Bool)
(declare-const required1 Bool)
(declare-const link00 Bool)
(declare-const link01 Bool)
(declare-const link10 Bool)
(declare-const link11 Bool)
(declare-const reqTarget0 (_ BitVec 1))
(declare-const reqTarget1 (_ BitVec 1))
(declare-const propTarget0 (_ BitVec 1))
(declare-const propTarget1 (_ BitVec 1))
(declare-const verified0 Bool)
(declare-const verified1 Bool)
(declare-const scope0 (_ BitVec 2))
(declare-const scope1 (_ BitVec 2))
(declare-const claim0 Bool)
(declare-const claim1 Bool)
(declare-const claimScope0 (_ BitVec 2))
(declare-const claimScope1 (_ BitVec 2))
(declare-const hide_unmapped Bool)
(declare-const complete_with_unmapped Bool)
(declare-const overclaim_scope Bool)
(declare-const bad_scope_target Bool)
(declare-const compare_mismatch Bool)
(declare-const compare_unknown Bool)

(define-fun valid00 () Bool (and link00 (= reqTarget0 propTarget0)))
(define-fun valid01 () Bool (and link01 (= reqTarget0 propTarget1)))
(define-fun valid10 () Bool (and link10 (= reqTarget1 propTarget0)))
(define-fun valid11 () Bool (and link11 (= reqTarget1 propTarget1)))
(define-fun missing0 () Bool (and required0 (not (or valid00 valid01))))
(define-fun missing1 () Bool (and required1 (not (or valid10 valid11))))
(define-fun supported0 () (_ BitVec 2)
  (bvor (ite (and verified0 (or valid00 (and bad_scope_target link00 (= reqTarget1 propTarget0)))) scope0 #b00)
        (ite (and valid01 verified1) scope1 #b00)))
(define-fun supported1 () (_ BitVec 2)
  (bvor (ite (and valid10 verified0) scope0 #b00) (ite (and valid11 verified1) scope1 #b00)))

; A result presentation records uncovered requirements and can only claim supported regions.
(declare-const reportMissing0 Bool)
(declare-const reportMissing1 Bool)
(declare-const complete Bool)
(assert (= reportMissing0 (and missing0 (not hide_unmapped))))
(assert (= reportMissing1 (and missing1 (not hide_unmapped))))
(assert (= complete (or (and (not missing0) (not missing1)) complete_with_unmapped)))
(assert (=> claim0 (or overclaim_scope (not (= supported0 #b00)))))
(assert (=> claim1 (or overclaim_scope (not (= supported1 #b00)))))
(assert (=> claim0 (or overclaim_scope (= (bvand claimScope0 (bvnot supported0)) #b00))))
(assert (=> claim1 (or overclaim_scope (= (bvand claimScope1 (bvnot supported1)) #b00))))

; Each comparison dimension has two known values and an explicit unknown sentinel.
; 00 unknown, 01/10 known alternatives; 11 is outside the modeled domain.
(declare-const leftTarget (_ BitVec 2))
(declare-const rightTarget (_ BitVec 2))
(declare-const leftProperty (_ BitVec 2))
(declare-const rightProperty (_ BitVec 2))
(declare-const leftAssumption (_ BitVec 2))
(declare-const rightAssumption (_ BitVec 2))
(declare-const leftRange (_ BitVec 2))
(declare-const rightRange (_ BitVec 2))
(assert (and (not (= leftTarget #b11)) (not (= rightTarget #b11))
             (not (= leftProperty #b11)) (not (= rightProperty #b11))
             (not (= leftAssumption #b11)) (not (= rightAssumption #b11))
             (not (= leftRange #b11)) (not (= rightRange #b11))))
(define-fun known-match ((a (_ BitVec 2)) (b (_ BitVec 2))) Bool
  (and (not (= a #b00)) (not (= b #b00)) (= a b)))
(define-fun comparable () Bool
  (and (known-match leftTarget rightTarget) (known-match leftProperty rightProperty)
       (known-match leftAssumption rightAssumption) (known-match leftRange rightRange)))
(declare-const comparisonReported Bool)
(assert (= comparisonReported
  (or comparable
      (and compare_mismatch (not comparable))
      (and compare_unknown (or (= leftTarget #b00) (= rightTarget #b00)
                               (= leftProperty #b00) (= rightProperty #b00)
                               (= leftAssumption #b00) (= rightAssumption #b00)
                               (= leftRange #b00) (= rightRange #b00))))))

; Independent obligations check presentation against actual inputs and outcomes.
(define-fun missing_hidden () Bool
  (or (and required0 (not (or (and link00 (= reqTarget0 propTarget0))
                               (and link01 (= reqTarget0 propTarget1)))) (not reportMissing0))
      (and required1 (not (or (and link10 (= reqTarget1 propTarget0))
                               (and link11 (= reqTarget1 propTarget1)))) (not reportMissing1))))
(define-fun complete_with_missing () Bool
  (and complete (or (and required0 (not (or (and link00 (= reqTarget0 propTarget0))
                                              (and link01 (= reqTarget0 propTarget1)))))
                    (and required1 (not (or (and link10 (= reqTarget1 propTarget0))
                                              (and link11 (= reqTarget1 propTarget1))))))))
(define-fun claims_outside_verified () Bool
  (let ((expected0 (bvor (ite (and link00 (= reqTarget0 propTarget0) verified0) scope0 #b00)
                         (ite (and link01 (= reqTarget0 propTarget1) verified1) scope1 #b00)))
        (expected1 (bvor (ite (and link10 (= reqTarget1 propTarget0) verified0) scope0 #b00)
                         (ite (and link11 (= reqTarget1 propTarget1) verified1) scope1 #b00))))
    (or (and claim0 (or (= expected0 #b00) (not (= (bvand claimScope0 (bvnot expected0)) #b00))))
        (and claim1 (or (= expected1 #b00) (not (= (bvand claimScope1 (bvnot expected1)) #b00)))))))
(define-fun invalid_comparison () Bool
  (and comparisonReported
       (or (= leftTarget #b00) (= rightTarget #b00) (not (= leftTarget rightTarget))
           (= leftProperty #b00) (= rightProperty #b00) (not (= leftProperty rightProperty))
           (= leftAssumption #b00) (= rightAssumption #b00) (not (= leftAssumption rightAssumption))
           (= leftRange #b00) (= rightRange #b00) (not (= leftRange rightRange)))))
