(set-logic QF_AUFLIA)
(set-option :timeout 10000)
; Two job slots. Transport identities are supplied trusted fields, not authenticated.
(declare-const currentRun Int)
(declare-const currentVersion Int)
(declare-const bad_run Bool)
(declare-const bad_version Bool)
(declare-const bad_duplicate Bool)
(declare-const bad_source Bool)
(declare-const bad_record_source Bool)
(declare-const bad_record_value Bool)
(declare-fun seen (Int) (Array Int Bool))
(declare-fun value (Int) (Array Int Int))
(declare-fun source (Int) (Array Int Int))
(declare-fun accepted (Int) Bool)
(declare-fun msgJob (Int) Int)
(declare-fun msgSource (Int) Int)
(declare-fun msgRun (Int) Int)
(declare-fun msgVersion (Int) Int)
(declare-fun msgValue (Int) Int)
(define-fun init () Bool
 (and (= (seen 0) ((as const (Array Int Bool)) false))
      (= (value 0) ((as const (Array Int Int)) 0))
      (= (source 0) ((as const (Array Int Int)) (- 1))) (not (accepted 0))))
(define-fun valid ((t Int)) Bool
 (and (<= 0 (msgJob t)) (<= (msgJob t) 1) (= (msgSource t) (msgJob t))
      (= (msgRun t) currentRun) (= (msgVersion t) currentVersion)
      (not (select (seen t) (msgJob t))) (<= 1 (msgValue t)) (<= (msgValue t) 5)))
(define-fun next ((t Int) (n Int)) Bool
 (and (= (accepted n)
   (and (<= 0 (msgJob t)) (<= (msgJob t) 1)
     (or bad_source (= (msgSource t) (msgJob t)))
     (or bad_run (= (msgRun t) currentRun)) (or bad_version (= (msgVersion t) currentVersion))
     (or bad_duplicate (not (select (seen t) (msgJob t)))) (<= 1 (msgValue t)) (<= (msgValue t) 5)))
   (= (seen n) (ite (accepted n) (store (seen t) (msgJob t) true) (seen t)))
   (= (value n) (ite (accepted n) (store (value t) (msgJob t) (ite bad_record_value (+ (msgValue t) 1) (msgValue t))) (value t)))
   (= (source n) (ite (accepted n) (store (source t) (msgJob t) (ite bad_record_source (- 1 (msgSource t)) (msgSource t))) (source t)))))
(assert init)
