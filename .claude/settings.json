{
  "cleanupPeriodDays": 30,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1m]",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_LANGUAGE": "ja"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(**)",
      "Glob(**)",
      "Grep(**)",
      "LS(**)",
      "MultiEdit(**)",
      "Read(**)",
      "TodoWrite(**)",
      "WebFetch(domain:*)",
      "Write(**)",
      "mcp__serena",
      "mcp__codex",
      "WebSearch"
    ],
    "deny": [
      "Read(.env.*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*.token)",
      "Read(**/*.key)",
      "Write(.env*)",
      "Write(**/secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",
      "Bash(* | bash)",
      "Bash(* | sh)",
      "Bash(> /dev/sda*)",
      "Bash(brew install*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod 777*)",
      "Bash(chown -R*)",
      "Bash(dd *)",
      "Bash(format*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh gist create*)",
      "Bash(gh gist delete*)",
      "Bash(gh gpg-key add*)",
      "Bash(gh gpg-key delete*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release upload*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo clone*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh secret delete*)",
      "Bash(gh secret set*)",
      "Bash(gh ssh-key add*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh workflow disable*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow run:*)",
      "Bash(git checkout*)",
      "Bash(git config*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git restore*)",
      "Bash(mkfs*)",
      "Bash(pip install*)",
      "Bash(rm -rf ../*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo*)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(uname)\" = \"Darwin\" ] && osascript -e 'display notification \"確認待ち\" with title \"Claude Code\"' && afplay -v 0.3 /System/Library/Sounds/Sosumi.aiff || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(uname)\" = \"Darwin\" ] && osascript -e 'display notification \"タスク完了\" with title \"Claude Code\"' && afplay -v 0.3 /System/Library/Sounds/Sosumi.aiff || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "codex@openai-codex": true
  },
  "effortLevel": "high",
  "advisorModel": "opus[1m]",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "permissionMode": "auto"
}
