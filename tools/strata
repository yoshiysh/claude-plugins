#!/bin/bash
# Strata executable wrapper: runs high-speed Rust binary if built, builds on demand if cargo is available.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
BIN_PATH="${REPO_ROOT}/crates/strata/target/release/strata"

if [ ! -f "${BIN_PATH}" ]; then
  if command -v cargo >/dev/null 2>&1; then
    echo "[strata] Building release binary..." >&2
    cargo build --release --manifest-path "${REPO_ROOT}/crates/strata/Cargo.toml" >&2
  else
    echo "Error: Strata binary not found at ${BIN_PATH} and 'cargo' is not installed." >&2
    exit 1
  fi
fi

exec "${BIN_PATH}" "$@"
