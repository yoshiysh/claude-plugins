{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/dynamic-workflow-translation-review-input/v1",
  "title": "Dynamic Workflow Translation Review Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "manifest"],
  "properties": {
    "schema_version": { "const": "dynamic-workflow-translation-review-input/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonical_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "workflow_call": { "$ref": "#/$defs/workflow_call_binding" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "phase_list": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "caller_phase_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "pre_workflow", "post_workflow", "human_gates"],
      "properties": {
        "owner": { "const": "caller_skill" },
        "pre_workflow": { "$ref": "#/$defs/phase_list" },
        "post_workflow": { "$ref": "#/$defs/phase_list" },
        "human_gates": { "$ref": "#/$defs/phase_list" }
      }
    },
    "native_workflow_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "available", "observed_at", "evidence"],
      "properties": {
        "attempted": { "const": false },
        "available": { "const": false },
        "observed_at": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "workflow_call_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "caller_phase_ownership", "native_workflow_observation"],
      "properties": {
        "receipt": { "$ref": "#/$defs/file_ref" },
        "caller_phase_ownership": { "$ref": "#/$defs/caller_phase_ownership" },
        "native_workflow_observation": { "$ref": "#/$defs/native_workflow_observation" }
      }
    }
  }
}
