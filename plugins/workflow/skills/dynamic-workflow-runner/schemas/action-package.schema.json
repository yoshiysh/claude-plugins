{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/dynamic-workflow-action-package/v1",
  "title": "Dynamic Workflow External Action Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "source_task_id", "action_id", "action", "targets", "scope", "parameters",
    "preconditions", "expected_effects", "read_back", "idempotency", "executor_capabilities", "lineage", "external_effects_performed"
  ],
  "properties": {
    "schema_version": { "const": "dynamic-workflow-action-package/v1" },
    "package_id": { "$ref": "#/$defs/id" },
    "source_task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "action_id": { "$ref": "#/$defs/id" },
    "action": { "type": "string", "minLength": 1 },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "parameters": { "type": "object" },
    "preconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "expected_effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "read_back": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "success_criteria"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "success_criteria": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "behavior"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "behavior": { "enum": ["safe_to_retry", "verify_before_retry", "not_retryable"] }
      }
    },
    "executor_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/semantic_id" }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "manifest_sha256", "capability_snapshot_sha256", "task_input_manifest_sha256", "result_contract_sha256"],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "capability_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "task_input_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "result_contract_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "external_effects_performed": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "semantic_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 160 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
