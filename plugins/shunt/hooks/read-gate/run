#!/bin/bash
# Block full-file reads on large files, redirect to /bulk-reader skill
# Self-contained: all routing logic lives here, no CLAUDE.md needed
#
# Fork note: same treatment as bash-read-gate — deterministic guards
# (targeted reads, missing files, small files) are upstream-verbatim; the
# final line-count judgment becomes a typed model decision with the upstream
# rule as the declared fallback. Allow is empty stdout for the same host
# compatibility reason documented in bash-read-gate.

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

input=$(cat)

file_path=$(echo "$input" | jq -r '.tool_input.file_path // empty')
offset=$(echo "$input" | jq -r '.tool_input.offset // empty')
limit=$(echo "$input" | jq -r '.tool_input.limit // empty')

# Allow targeted reads (offset or limit set) — Claude already knows what it needs
if [ -n "$offset" ] || [ -n "$limit" ]; then
  exit 0
fi

# Allow if file doesn't exist or path is empty
if [ -z "$file_path" ] || [ ! -f "$file_path" ]; then
  exit 0
fi

# Allow small files — delegation overhead isn't worth it
lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
if [ "$lines" -le "$MIN_LINES" ]; then
  exit 0
fi

. "$(cd "$(dirname "$0")/../../scripts/lib" && pwd)/gemini.sh"

# Fidelity-axis input: see bash-read-gate for why this is capped and real.
sample=$(head -40 -- "$file_path" 2>/dev/null | cut -c1-200)

block() { printf '{"decision": "block", "reason": "%s"}\n' "$1"; }

# Fallback reasons split the same way as bash-read-gate: a failed preflight
# rules out /bulk-reader too. Read carries no purpose field, so the gate gets
# an empty (unknown) purpose.
if ! shunt_preflight >/dev/null 2>&1; then
  block "File is ${lines} lines (threshold: ${MIN_LINES}); the delegation worker is unavailable (API key, jq or curl missing), so the model gate cannot run and this is the fallback line rule. Re-read with an offset/limit for just the section you need."
elif verdict=$(shunt_decide "Read ${file_path}" "$file_path" "$lines" "$MIN_LINES" "$sample" ""); then
  if [ "$verdict" != "allow" ]; then
    block "Model gate judged this a bulk read (${lines} lines). Use the /bulk-reader skill to delegate this read instead of reading it directly. If you need exact content for editing, re-read with an offset/limit for just the section you need."
  fi
else
  block "File is ${lines} lines (threshold: ${MIN_LINES}); the model gate could not be consulted (request failed, timed out, or returned no usable decision), so this is the fallback line rule. Use the /bulk-reader skill to delegate this read, or re-read with an offset/limit for just the section you need."
fi
