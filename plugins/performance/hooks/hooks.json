{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E -s -B \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/event-collector/run.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E -s -B \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/event-collector/run.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E -s -B \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/event-collector/run.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E -s -B \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/event-collector/run.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E -s -B \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/bulk-read-probe/run.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E -s -B \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/event-collector/run.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
