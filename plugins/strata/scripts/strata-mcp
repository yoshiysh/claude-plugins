#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

resolve_strata_api_base() {
  if [ -n "${STRATA_API_BASE:-}" ]; then
    printf '%s\n' "$STRATA_API_BASE"
    return 0
  fi

  local port="${STRATA_PORT:-8080}"
  local ssh_host="${STRATA_HOST:-winbox}"
  local candidates=()
  if [ -n "${STRATA_LAN_HOST:-}" ]; then
    candidates+=("$STRATA_LAN_HOST")
  fi
  if [ "${STRATA_LAN_RESOLVE:-1}" != "0" ] && command -v ssh >/dev/null 2>&1 && command -v curl >/dev/null 2>&1; then
    local ssh_ip win_name
    ssh_ip="$(ssh -G "$ssh_host" 2>/dev/null | awk '/^hostname / {print $2; exit}' || true)"
    win_name="$(ssh -o ConnectTimeout=1 -o BatchMode=yes "$ssh_host" hostname 2>/dev/null | tr -d '\r\n' || true)"
    if [ -n "$win_name" ]; then
      candidates+=("${win_name}.local")
    fi
    if [ -n "$ssh_ip" ]; then
      candidates+=("$ssh_ip")
    fi
    for host in "${candidates[@]}"; do
      local url="http://${host}:${port}/v1"
      if curl -sS -m 1 -o /dev/null "${url}/models" 2>/dev/null; then
        printf '%s\n' "$url"
        return 0
      fi
    done
  fi

  printf 'http://127.0.0.1:%s/v1\n' "$port"
}

export STRATA_API_BASE="$(resolve_strata_api_base)"

LOCAL_BIN="$SCRIPT_DIR/../../../crates/strata/target/release/strata"
if [ -x "$LOCAL_BIN" ]; then
  exec "$LOCAL_BIN" mcp "$@"
fi

PLUGIN_VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PLUGIN_ROOT/.claude-plugin/plugin.json" | head -n 1)"
PLUGIN_VERSION="${PLUGIN_VERSION:-0.1.0}"
CACHE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/strata/${PLUGIN_VERSION}"
CACHE_BIN="${CACHE_ROOT}/bin/strata"
if [ -x "$CACHE_BIN" ]; then
  exec "$CACHE_BIN" mcp "$@"
fi

if command -v strata >/dev/null 2>&1; then
  exec strata mcp "$@"
fi

# MCP startup has a 30s default timeout; fail fast instead of running a release cargo build synchronously.
cat >&2 <<EOF
Error: 'strata' binary not found.
Pre-install the matching version before starting the MCP server:
  cargo install --locked --git https://github.com/yoshiysh/claude-plugins.git --tag strata-v${PLUGIN_VERSION} --bin strata --root "${CACHE_ROOT}"
EOF
exit 1
